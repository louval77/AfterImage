   Variable (set by src/lib/atmosphere.ts): palette, photo grade, texture, composition, rhythm, motion. */

.df {
  margin: 0;
  display: grid;
  gap: 14px;
  min-width: 0;
}

.df-page {
  position: relative;
  aspect-ratio: 4 / 5;
  container-type: inline-size;
  overflow: hidden;
  isolation: isolate;
  background: var(--df-paper);
  color: var(--df-ink);
  border-radius: 3px;
