          <rect x="18" y="12" width="22" height="10" rx="2" fill="#E9DDC6" stroke={INK} strokeWidth="3" />
          <circle cx="54" cy="47" r="19" fill="#5D6B73" stroke={INK} strokeWidth="3" />
          <circle cx="54" cy="47" r="9" fill="#2B2724" />
