  color: var(--ink-3);
}
.set-legal {
  display: flex;
  gap: 20px;
  margin-top: 36px;
  font-size: 14px;
}

/* ---------- the story and the letter: an old letter on aged paper ----------
   The red margin is drawn at --margin and the text always starts to the right of it; the ruled lines
   follow the line height and scroll with the text (background-attachment: local). */
.story-input,
.letter-input {
  --line: 1.7em;
  --margin: clamp(34px, 7vw, 60px);
  --top: calc(var(--line) * 0.55);
  padding: var(--top) clamp(16px, 3vw, 30px) var(--line) calc(var(--margin) + clamp(14px, 2vw, 20px));
  font: 400 clamp(19px, 2.1vw, 22px) / var(--line) var(--serif);
  color: #2c241d;
  caret-color: #7a2e2e;
  background-color: #f4ead6;
  background-image:
    linear-gradient(
      90deg,
      transparent calc(var(--margin) - 5px),
      rgb(166 60 52 / 0.5) calc(var(--margin) - 5px) calc(var(--margin) - 4px),
      transparent calc(var(--margin) - 4px) var(--margin),
      rgb(166 60 52 / 0.5) var(--margin) calc(var(--margin) + 1px),
      transparent calc(var(--margin) + 1px)
    ),
    repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), rgb(120 92 60 / 0.18) calc(var(--line) - 1px) var(--line)),
    url('/demo/textures/paper-ivory.jpg');
  background-size:
    auto,
    100% var(--line),
    520px auto;
  /* the rules sit just under each line's baseline */
  background-position:
    0 0,
    0 calc(var(--top) - 0.36em),
    0 0;
  background-repeat: no-repeat, repeat-y, repeat;
  background-attachment: local, local, local;
  background-blend-mode: normal, normal, multiply;
  border: 1px solid #d9c6a6;
  border-radius: 2px;
  box-shadow:
    inset 0 0 70px rgb(150 110 60 / 0.2),
    inset 0 0 0 1px rgb(255 252 244 / 0.5);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}
.story-input::placeholder,
.letter-input::placeholder {
  color: rgb(90 70 50 / 0.5);
  font-style: italic;
}
.story-input:focus,
.letter-input:focus {
  border-color: #b48c5c;
  box-shadow:
    inset 0 0 70px rgb(150 110 60 / 0.2),
    0 0 0 3px rgb(122 46 46 / 0.2);
}

/* a room that is still arriving over the network: just the paper, no spinner */
.room-wait {
  min-height: 70vh;
}

/* ---- skip the navigation (visible only when it has keyboard focus) ---- */
.skip-link {
  position: fixed;
  z-index: 1000;
  left: 12px;
  top: 12px;
  padding: 10px 16px;
  border: 0;
  border-radius: 999px;
  background: var(--ink);
  color: var(--paper);
  font: 500 14px var(--sans);
  transform: translateY(-160%);
  transition: transform 0.15s ease;
}
.skip-link:focus-visible {
  transform: none;
  outline: 2px solid var(--burgundy);
  outline-offset: 2px;
}
.shell main:focus {
  outline: none;
}

/* long words and links in a story never push the page sideways on a phone */
.story p,
.margin-notes p,
.details li,
.timeline li,
.ledger-print .quote,
.letter-p {
  overflow-wrap: break-word;
}

