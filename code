      <circle className="df-geo-dot" cx={88 + r(3, 6)} cy={58 + r(4, 8)} r="3.2" />
      <path className="df-geo-tri" d={`M ${70 + r(5, 6)} 76 L 96 76 L ${84 + r(6, 6)} ${52 + r(7, 6)} Z`} />
      <line className="df-geo-cut" x1="2" y1={70 + r(8, 8)} x2="98" y2={8 + r(9, 6)} />
