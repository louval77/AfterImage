}

/* ---------- the canvas around the page follows the room (overscroll, rubber-banding) ---------- */
html[data-room='paper'],
html[data-room='paper'] body {
  background: var(--ivory);
}
html[data-room='dark'],
html[data-room='dark'] body {
  background: #17110d;
}

/* ---- privacy and terms ---- */
.legal {
  max-width: 760px;
}
.legal-body {
  margin-top: 28px;
}
.legal-body h1 {
  font: 500 clamp(36px, 5vw, 56px) / 1.02 var(--serif);
