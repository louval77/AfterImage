====================================================================
/* ==========================================================================
   Afterimage — two rooms: paper (ivory, ink) and the darkroom (warm black, safelight)
   ========================================================================== */

:root {
  --ivory: #f3ede2;
  --paper: #fbf8f2;
  --cream: #ebe2d2;
  --ink: #26221e;
  --ink-2: #5a524a;
  --ink-3: #6b6258;
  --rule: #d9cfbf;
  --burgundy: #7a2e2e;
  --terra: #a0563c;
  --olive: #6e6e45;
  --accent: var(--burgundy);

  --serif: 'Cormorant Garamond', 'EB Garamond', Garamond, 'Times New Roman', serif;
  --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  --hand: 'Caveat', 'Bradley Hand', 'Segoe Print', cursive;
  --type: 'Special Elite', 'Courier New', monospace;

  --gutter: clamp(16px, 4vw, 56px);
  --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  --grain: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .5  0 0 0 0 .5  0 0 0 1.1 -.2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}

* {
  box-sizing: border-box;
}
html {
  -webkit-text-size-adjust: 100%;
}
body {
  margin: 0;
  background: var(--ivory);
  color: var(--ink);
  font: 400 16px/1.55 var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
img {
  display: block;
  max-width: 100%;
}
button,
input,
textarea,
select {
  font: inherit;
  color: inherit;
}
button {
  cursor: pointer;
}
a {
  color: inherit;
}
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
.sr-only {
  position: absolute !important;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
h1,
h2,
h3 {
  margin: 0;
  font-weight: 500;
}
p {
  margin: 0;
}

.boot {
  min-height: 100vh;
  display: grid;
  place-items: center;
  font: italic 500 28px var(--serif);
  color: var(--ink-3);
  animation: breathe 2s ease-in-out infinite;
}
.banner-error {
  background: var(--burgundy);
  color: var(--paper);
  padding: 10px var(--gutter);
  font-size: 14px;
}

/* ---------- shared atoms ---------- */
.row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 18px;
}
.kicker {
  font: 600 11px/1.2 var(--sans);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 10px;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid transparent;
  padding: 11px 20px;
  font: 500 14px/1 var(--sans);
  letter-spacing: 0.01em;
  text-decoration: none;
  border-radius: 2px;
  transition: background 0.25s, color 0.25s, transform 0.15s, border-color 0.25s;
  min-height: 44px;
}
.btn:active {
  transform: translateY(1px);
}
.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
.btn-sm {
  padding: 8px 14px;
  min-height: 36px;
  font-size: 13px;
}
.btn-ink {
  background: var(--ink);
  color: var(--paper);
}
.btn-ink:hover:not(:disabled) {
  background: var(--burgundy);
}
.btn-ghost-ink {
  border-color: var(--ink);
  background: transparent;
}
.btn-ghost-ink:hover {
  background: var(--ink);
  color: var(--paper);
}
.btn-light {
  background: var(--dr-ink, var(--paper));
  color: var(--dr-bg, var(--ink));
}
.btn-light:hover:not(:disabled) {
  background: var(--dr-accent, var(--cream));
  color: var(--dr-bg, var(--ink));
}
.btn-ghost {
  border-color: color-mix(in srgb, var(--dr-ink, var(--ink)) 45%, transparent);
  background: transparent;
  color: var(--dr-ink, var(--ink));
}
.btn-ghost:hover {
  border-color: var(--dr-ink, var(--ink));
}
.link {
  background: none;
  border: 0;
  padding: 4px 0;
  font-size: 14px;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 4px;
  text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  color: var(--ink-2);
}
.link:hover {
  color: var(--ink);
  text-decoration-color: currentColor;
}
.link-dark {
  color: var(--dr-muted, #b7aa9a);
}
.link-dark:hover {
  color: var(--dr-ink, #efe6d8);
}
.link.danger:hover,
.danger {
  color: var(--burgundy);
}
.link-dark.danger,
.darkroom .danger {
  color: #d98270;
}
.confirm {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  font-size: 14px;
}
.back {
  font: 500 13px var(--sans);
  text-decoration: none;
  color: var(--ink-2);
  letter-spacing: 0.02em;
  display: inline-flex;
  gap: 8px;
  padding: 8px 0;
}
.back:hover {
  color: var(--ink);
}
.back-dark {
  color: var(--dr-muted);
}
.back-dark:hover {
  color: var(--dr-ink);
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--rule);
  background: transparent;
  padding: 7px 12px;
  font-size: 13px;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.2s;
  min-height: 36px;
}
.chip input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.chip:hover {
  border-color: var(--ink-2);
}
.chip.is-on {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.chip:has(input:focus-visible) {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip-suggest {
  font-family: var(--serif);
  font-size: 16px;
  font-style: italic;
}

/* the three voices */
.voice {
  display: inline-flex;
  gap: 6px;
  align-items: baseline;
  font: 500 11px/1.4 var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.voice a {
  color: inherit;
}
.voice-mark {
  font-size: 12px;
  letter-spacing: 0;
}
.app-voice {
  font: 400 14px/1.55 var(--sans);
  color: var(--ink-2);
  display: flex;
  gap: 8px;
  align-items: baseline;
}
.app-voice.dark {
  color: var(--dr-muted);
}
.app-mark {
  color: var(--accent);
  font-size: 12px;
  flex: none;
}
.darkroom .app-mark {
  color: var(--dr-accent);
}
.quote {
  margin: 0;
  font: italic 400 clamp(21px, 2.4vw, 26px) / 1.3 var(--serif);
  color: inherit;
}
.present {
  font: italic 400 18px/1.45 var(--serif);
  color: var(--accent);
}
.present-date {
  font: 500 11px var(--sans);
  letter-spacing: 0.08em;
  color: var(--ink-3);
  font-style: normal;
}
.demo-tag {
  display: inline-block;
  font: 600 9px/1 var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  border: 1px solid currentColor;
  padding: 3px 5px;
  margin-left: 8px;
  opacity: 0.65;
  vertical-align: middle;
}
p.demo-tag {
  margin: 0 0 12px;
}

/* wax seal & envelope */
.wax {
  flex: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  font: italic 600 18px var(--serif);
  color: #f1d9c9;
  background: radial-gradient(circle at 35% 30%, #a54a40, var(--burgundy) 55%, #4f1a1a);
  box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.12), 0 1px 0 rgba(0, 0, 0, 0.2);
  clip-path: polygon(50% 0, 61% 6%, 75% 4%, 82% 16%, 95% 22%, 94% 37%, 100% 50%, 94% 63%, 95% 78%, 82% 84%, 75% 96%, 61% 94%, 50% 100%, 39% 94%, 25% 96%, 18% 84%, 5% 78%, 6% 63%, 0 50%, 6% 37%, 5% 22%, 18% 16%, 25% 4%, 39% 6%);
}
.wax-lg {
  width: 64px;
  height: 64px;
  font-size: 30px;
}

/* ==========================================================================
   PAPER ROOM
   ========================================================================== */
.paper {
  min-height: 100vh;
  padding: 0 var(--gutter) 80px;
  max-width: 1320px;
  margin: 0 auto;
  background: var(--ivory);
}

/* masthead */
.masthead {
  padding-top: 18px;
  text-align: center;
  border-bottom: 3px double var(--ink);
  padding-bottom: 22px;
}
.masthead-rule {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12px;
  font: 500 12px var(--sans);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-2);
  border-bottom: 1px solid var(--ink);
  padding-bottom: 10px;
}
.masthead-rule > :first-child {
  text-align: left;
}
.masthead-date {
  font: italic 500 16px var(--serif);
  text-transform: none;
  letter-spacing: 0;
}
.masthead-nav {
  display: flex;
  justify-content: flex-end;
  gap: 18px;
  flex-wrap: wrap;
}
.masthead-nav a {
  text-decoration: none;
}
.masthead-nav a:hover {
  color: var(--burgundy);
}
.nav-new {
  color: var(--burgundy);
}
.masthead-title {
  font: 500 clamp(64px, 13vw, 168px) / 0.9 var(--serif);
  letter-spacing: -0.02em;
  margin-top: 22px;
}
.masthead-sub {
  font: italic 400 clamp(19px, 2.4vw, 26px) / 1.2 var(--serif);
  color: var(--ink-2);
  margin-top: 8px;
}

.howto {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--rule);
}
.howto li {
  display: flex;
  gap: 14px;
  padding: 20px 22px 22px 0;
  font-size: 14px;
  color: var(--ink-2);
}
.howto li + li {
  padding-left: 22px;
  border-left: 1px solid var(--rule);
}
.howto strong {
  color: var(--ink);
  font-weight: 600;
}
.howto-n {
  font: 500 30px/1 var(--serif);
  color: var(--accent);
  flex: none;
  width: 28px;
}

.section {
  margin-top: 56px;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--ink);
  padding-bottom: 8px;
  margin-bottom: 22px;
}
.section-head h2 {
  font: 500 34px/1 var(--serif);
}
.section-meta {
  font-size: 13px;
  color: var(--ink-3);
}

/* arrived letter */
.arrived {
  margin-top: 44px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 40px;
  align-items: center;
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 34px clamp(20px, 4vw, 48px);
  position: relative;
  animation: rise 0.9s var(--ease) both;
}
.arrived::before {
  content: '';
  position: absolute;
  inset: 6px;
  border: 1px dashed var(--rule);
  pointer-events: none;
}
.arrived h2 {
  font: 500 clamp(28px, 4vw, 42px) / 1.05 var(--serif);
  max-width: 18ch;
}
.arrived-meta {
  margin: 12px 0 20px;
  color: var(--ink-2);
}
.envelope {
  width: 190px;
  height: 128px;
  position: relative;
  background: #e6d9c3;
  border: 1px solid #cdbda3;
  box-shadow: 0 18px 30px -24px rgba(38, 34, 30, 0.6);
  transform: rotate(-4deg);
  display: grid;
  place-items: center;
  animation: wiggle 5s ease-in-out infinite;
}
.envelope-flap {
  position: absolute;
  inset: 0 0 auto;
  height: 70px;
  background: #dccdb3;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  border-bottom: 1px solid #cdbda3;
}
.envelope .wax {
  position: relative;
  top: -4px;
}

/* drying line */
.line-wrap {
  overflow-x: auto;
  overflow-y: hidden;
  margin: 0 calc(var(--gutter) * -1);
  padding: 0 var(--gutter) 14px;
  scroll-snap-type: x proximity;
  scrollbar-width: thin;
  scrollbar-color: var(--rule) transparent;
}
.line {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 28px;
  padding-top: 26px;
  min-width: min-content;
}
.line-wire {
  position: absolute;
  left: -40px;
  right: -40px;
  top: 18px;
  height: 1px;
  background: var(--ink-2);
}
.line-year {
  font: italic 500 22px/1 var(--serif);
  color: var(--ink-3);
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  padding: 30px 0 0;
  flex: none;
}
.neg,
.line-new {
  flex: none;
  width: clamp(230px, 26vw, 300px);
  text-decoration: none;
  position: relative;
  scroll-snap-align: start;
  transform-origin: 50% -8px;
  transform: rotate(var(--tilt, 0deg));
  transition: transform 0.6s var(--ease);
}
.neg:hover,
.neg:focus-visible {
  transform: rotate(0) translateY(4px);
}
.neg:hover .neg-photo {
  --neg: 0.5 !important;
}
.pin {
  position: absolute;
  top: -14px;
  left: 50%;
  width: 12px;
  height: 28px;
  margin-left: -6px;
  background: linear-gradient(90deg, #b9a888, #e4d6bd 50%, #b9a888);
  border-radius: 2px;
  z-index: 2;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}
.neg-frame {
  display: block;
  position: relative;
  background: #1c1916;
  padding: 16px 10px;
  box-shadow: 0 22px 34px -26px rgba(38, 34, 30, 0.75);
}
.sprockets {
  position: absolute;
  inset: 4px 10px;
  pointer-events: none;
  background:
    repeating-linear-gradient(90deg, #e8decb 0 7px, transparent 7px 16px) top / 100% 6px no-repeat,
    repeating-linear-gradient(90deg, #e8decb 0 7px, transparent 7px 16px) bottom / 100% 6px no-repeat;
  opacity: 0.85;
}
.neg-cap {
  display: grid;
  gap: 2px;
  padding: 12px 2px 0;
}
.neg-date {
  font: italic 500 15px var(--serif);
  color: var(--ink-3);
}
.neg-title {
  font: 500 23px/1.1 var(--serif);
}
.neg-status {
  font: 500 11px var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-top: 4px;
}
.neg-status.is-done {
  color: var(--olive);
}
.line-new-frame {
  display: grid;
  place-items: center;
  align-content: center;
  gap: 4px;
  aspect-ratio: 3/2.25;
  border: 1px dashed var(--ink-3);
  color: var(--ink-2);
  font: italic 500 20px var(--serif);
  transition: background 0.3s;
}
.line-new:hover .line-new-frame {
  background: var(--paper);
  color: var(--burgundy);
}
.plus {
  font: 300 44px/1 var(--serif);
}

/* threads */
.threads {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0;
}
.thread {
  padding: 22px 0;
  border-bottom: 1px solid var(--rule);
  display: grid;
  gap: 14px;
  transition: opacity 0.6s, transform 0.6s var(--ease);
}
.thread.is-stamping {
  opacity: 0.2;
  transform: translateX(30px);
}
.thread-foot {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
}

/* stamps */
.stamps {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.stamp-btn {
  font: 600 11px/1 var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 10px 13px;
  min-height: 38px;
  border: 1.5px solid currentColor;
  background: transparent;
  border-radius: 3px;
  color: var(--ink-2);
  transition: all 0.2s;
}
.stamp-btn:hover {
  transform: rotate(-2deg);
}
.stamp-kept {
  color: var(--olive);
}
.stamp-changed {
  color: var(--terra);
}
.stamp-let-go {
  color: var(--ink-3);
}
.stamp-trying {
  color: var(--burgundy);
}
.stamp-btn.is-on {
  background: currentColor;
}
.stamp-btn.is-on {
  color: var(--paper);
}
.stamp-btn.stamp-kept.is-on {
  background: var(--olive);
  border-color: var(--olive);
}
.stamp-btn.stamp-changed.is-on {
  background: var(--terra);
  border-color: var(--terra);
}
.stamp-btn.stamp-let-go.is-on {
  background: var(--ink-3);
  border-color: var(--ink-3);
}
.stamp-btn.stamp-trying.is-on {
  background: var(--burgundy);
  border-color: var(--burgundy);
}
.stamps-compact .stamp-btn {
  padding: 8px 10px;
  min-height: 34px;
}
.stamp-mark {
  display: inline-block;
  font: 700 13px/1 var(--sans);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 8px 12px;
  border: 2.5px double currentColor;
  transform: rotate(-6deg);
  opacity: 0.88;
  animation: stamp 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both;
}

/* post */
.toc-date {
  font: italic 500 15px var(--serif);
  color: var(--ink-3);
  flex: none;
  min-width: 130px;
}
.toc-title {
  font: 500 20px var(--serif);
}
.toc-dots {
  flex: 1;
  border-bottom: 1px dotted var(--ink-3);
  transform: translateY(-4px);
  min-width: 10px;
}
.toc-status {
  font: 500 11px var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.colophon {
  margin-top: 70px;
  border-top: 3px double var(--ink);
  padding-top: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 48px;
  font-size: 13px;
  color: var(--ink-2);
}
.colophon-actions {
  grid-column: 1 / -1;
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
}

/* ==========================================================================
   PHOTOGRAPH (developing)
   ========================================================================== */
.photo {
  position: relative;
  margin: 0;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #0f0d0b;
  --neg: 1;
  --blur: 7px;
  --sepia: 0.85;
  --sat: 0.35;
  --bright: 0.45;
  --safelight: 0.45;
}
.photo img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  user-select: none;
  -webkit-user-drag: none;
}
.photo-pos {
  filter: blur(var(--blur)) sepia(var(--sepia)) saturate(var(--sat)) brightness(var(--bright));
  transform: scale(1.04);
  transition: filter 1.8s var(--ease);
}
.photo-neg {
  filter: invert(1) grayscale(1) contrast(1.3) brightness(0.85) blur(calc(var(--blur) * 0.4));
  opacity: var(--neg);
  transition: opacity 1.8s var(--ease), filter 1.8s;
}
.photo-safelight {
  position: absolute;
  inset: 0;
  background: #8a2a1f;
  mix-blend-mode: multiply;
  opacity: var(--safelight);
  transition: opacity 1.8s;
  pointer-events: none;
}
.photo-empty {
  position: absolute;
  inset: 0;
  background: var(--cream);
}
.grain {
  position: absolute;
  inset: -50%;
  background-image: var(--grain);
  opacity: 0.22;
  mix-blend-mode: overlay;
  pointer-events: none;
  animation: grain 1.2s steps(6) infinite;
}
.photo[data-developed='true'] .grain {
  opacity: 0.12;
  animation: none;
}

/* ==========================================================================
   DARKROOM
   ========================================================================== */
.darkroom {
  --dr-bg: #17110d;
  --dr-bg-2: #211812;
  --dr-ink: #efe4d3;
  --dr-muted: #a89684;
  --dr-rule: rgba(239, 228, 211, 0.14);
  --dr-accent: #d3875f;
  --dr-glow: rgba(160, 52, 34, 0.42);
  --dr-head: var(--serif);
  min-height: 100vh;
  background:
    radial-gradient(ellipse 70% 50% at 50% -5%, var(--dr-glow), transparent 70%),
    var(--dr-bg);
  color: var(--dr-ink);
  padding: 0 var(--gutter) 80px;
  animation: lights-off 0.9s ease both;
}
.darkroom.theme-paper {
  --dr-bg: #12151b;
  --dr-bg-2: #1a1e26;
  --dr-ink: #ece6da;
  --dr-muted: #9ba1ad;
  --dr-accent: #e4c88e;
  --dr-glow: rgba(228, 200, 142, 0.2);
}
.darkroom.theme-night {
  --dr-bg: #0b0d0c;
  --dr-bg-2: #121614;
  --dr-ink: #cfd8bc;
  --dr-muted: #7f8a76;
  --dr-rule: rgba(207, 216, 188, 0.13);
  --dr-accent: #b9c98f;
  --dr-glow: rgba(150, 175, 120, 0.16);
  --dr-head: var(--mono);
}
.darkroom ::selection {
  background: var(--dr-accent);
  color: var(--dr-bg);
}
.darkroom :focus-visible {
  outline-color: var(--dr-accent);
}
.theme-night.darkroom::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
  animation: pulse var(--beat) ease-out infinite;
  z-index: 0;
}
.darkroom > * {
  position: relative;
  z-index: 1;
}
.dr-head {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12px;
  padding: 16px 0;
  border-bottom: 1px solid var(--dr-rule);
}
.dr-head > :last-child {
  justify-self: end;
}
.dr-title {
  display: grid;
  text-align: center;
}
.dr-date {
  font: 500 11px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--dr-muted);
}
.dr-name {
  font: italic 500 22px/1.2 var(--serif);
}
.theme-night .dr-name {
  font: 500 15px/1.4 var(--mono);
  font-style: normal;
}
.dr-missing {
  min-height: 60vh;
  display: grid;
  place-content: center;
  gap: 16px;
  text-align: center;
  font: italic 22px var(--serif);
}

.dr-baths {
  list-style: none;
  padding: 0;
  margin: 22px 0 30px;
  display: flex;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
}
.dr-baths li {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 6px 14px;
  color: var(--dr-muted);
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-bottom: 1px solid transparent;
  opacity: 0.55;
  transition: all 0.6s;
}
.dr-baths li.is-done {
  opacity: 0.8;
}
.dr-baths li.is-done .dr-bath-n::after {
  content: ' ✓';
  font-size: 11px;
}
.dr-baths li.is-now {
  opacity: 1;
  color: var(--dr-ink);
  border-bottom-color: var(--dr-accent);
}
.dr-bath-n {
  font: 500 17px var(--serif);
  letter-spacing: 0;
  color: var(--dr-accent);
}

.dr-stage {
  animation: rise 0.8s var(--ease) both;
}

/* sound toggle */
.sound-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: none;
  border: 1px solid var(--dr-rule, var(--rule));
  color: var(--dr-ink, var(--ink));
  padding: 6px 12px 6px 10px;
  border-radius: 999px;
  text-align: left;
  min-height: 40px;
  max-width: 260px;
}
.paper .sound-btn {
  border-color: var(--rule);
}
.sound-label {
  display: grid;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  min-width: 0;
}
.sound-song {
  font-weight: 400;
  color: var(--dr-muted, var(--ink-3));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 190px;
}
.sound-bars {
  display: inline-flex;
  gap: 2px;
  align-items: flex-end;
  height: 14px;
}
.sound-bars i {
  width: 3px;
  height: 4px;
  background: currentColor;
  border-radius: 1px;
}
.sound-btn.is-on .sound-bars i {
  animation: bar var(--beat, 0.6s) ease-in-out infinite alternate;
}
.sound-btn.is-on .sound-bars i:nth-child(2) {
  animation-delay: calc(var(--beat, 0.6s) * -0.33);
}
.sound-btn.is-on .sound-bars i:nth-child(3) {
  animation-delay: calc(var(--beat, 0.6s) * -0.66);
}

/* tray */
.tray {
  perspective: 1200px;
}
.tray-liquid {
  position: relative;
  padding: clamp(12px, 2vw, 22px);
  background: linear-gradient(180deg, #2a2420, #1a1512);
  border-radius: 4px;
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.06),
    inset 0 18px 40px rgba(0, 0, 0, 0.55),
    0 40px 60px -40px rgba(0, 0, 0, 0.9);
  animation: rock var(--rock, 6s) ease-in-out infinite;
  transform-origin: 50% 60%;
}
.theme-night .tray-liquid {
  background: #1a1d1b;
  border-radius: 12px;
  animation: none;
}
.theme-paper .tray-liquid {
  background: linear-gradient(180deg, #232832, #171a20);
}
.tray-liquid::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.05) 45%, transparent 60%);
  background-size: 250% 100%;
  animation: sheen calc(var(--rock, 6s) * 1) ease-in-out infinite;
  pointer-events: none;
}
.tray-photo {
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6);
}
.tray-sm {
  max-width: 460px;
}

/* bath layout */
.bath {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  gap: clamp(24px, 4vw, 56px);
  align-items: start;
  max-width: 1240px;
  margin: 0 auto;
}
.bath-sequence,
.bath-recall,
.bath-ledger,
.bath-meeting {
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
}
.bath-visual {
  position: sticky;
  top: 20px;
}
.bath-panel {
  display: grid;
  gap: 18px;
  align-content: start;
}
.bath-kicker {
  font: 500 11px var(--sans);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--dr-accent);
}
.bath-title {
  font: 500 clamp(32px, 4vw, 48px) / 1.02 var(--dr-head);
  letter-spacing: -0.01em;
}
.theme-night .bath-title {
  font-size: clamp(24px, 3vw, 34px);
  letter-spacing: -0.03em;
}
.bath-hint {
  color: var(--dr-muted);
  font-size: 15px;
  max-width: 56ch;
}
.bath .voice {
  color: var(--dr-muted);
}

/* surface */
.cover {
  position: absolute;
  inset: clamp(12px, 2vw, 22px);
  width: calc(100% - 2 * clamp(12px, 2vw, 22px));
  height: calc(100% - 2 * clamp(12px, 2vw, 22px));
  touch-action: none;
  cursor: grab;
  z-index: 3;
}
.cover:active {
  cursor: grabbing;
}
.cover-static {
  animation: flicker 0.18s steps(2) infinite;
}
.surface-spots {
  position: absolute;
  inset: clamp(12px, 2vw, 22px);
  z-index: 2;
  pointer-events: none;
}
.spot {
  position: absolute;
  max-width: 44%;
  font: italic 500 clamp(13px, 1.4vw, 17px) / 1.2 var(--serif);
  background: rgba(251, 248, 242, 0.92);
  color: var(--ink);
  padding: 6px 10px;
  box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.7);
  transform: rotate(-1.5deg);
  transition: transform 0.6s var(--ease), background 0.6s;
}
.spot:nth-child(even) {
  transform: rotate(1.5deg);
}
.spot.is-found {
  background: var(--paper);
  transform: rotate(0) scale(1.04);
}
.theme-night .spot {
  font: 500 12px/1.3 var(--mono);
  background: rgba(14, 26, 20, 0.92);
  color: #b9c98f;
  border: 1px solid #3f5a43;
}
.found {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
}
.found li {
  font: italic 500 20px/1.3 var(--serif);
  padding: 8px 0;
  border-bottom: 1px solid var(--dr-rule);
  color: var(--dr-muted);
}
.found li.is-found {
  color: var(--dr-ink);
  animation: develop-in 1s var(--ease) both;
}
.theme-night .found li {
  font: 400 14px/1.4 var(--mono);
}
.found-blank {
  letter-spacing: 0.3em;
  opacity: 0.4;
}

/* sequence */
.strips {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
  user-select: none;
}
.strips.is-dragging {
  cursor: grabbing;
}
.strip {
  display: grid;
  grid-template-columns: 30px 64px 1fr auto auto;
  align-items: center;
  gap: 12px;
  padding: 12px 12px 12px 6px;
  background: var(--dr-bg-2);
  border: 1px solid var(--dr-rule);
  border-left: 3px solid transparent;
  transition: transform 0.25s var(--ease), background 0.3s, border-color 0.4s, box-shadow 0.25s;
  position: relative;
}
.strip-handle {
  display: grid;
  gap: 3px;
  justify-content: center;
  padding: 10px 6px;
  cursor: grab;
  touch-action: none;
}
.strip-handle i {
  display: block;
  width: 14px;
  height: 2px;
  background: var(--dr-muted);
  border-radius: 1px;
}
.strip.is-lifted {
  transform: scale(1.02);
  box-shadow: 0 18px 30px -18px rgba(0, 0, 0, 0.9);
  background: color-mix(in srgb, var(--dr-bg-2) 70%, var(--dr-accent));
  z-index: 2;
}
.strip.is-fixed {
  border-left-color: var(--dr-accent);
  background: color-mix(in srgb, var(--dr-bg-2) 82%, var(--dr-accent));
  animation: fix 0.7s var(--ease);
}
.strip.is-fixed .strip-handle {
  visibility: hidden;
}
.strip-time {
  font: 500 14px var(--mono);
  color: var(--dr-muted);
}
.strip.is-fixed .strip-time {
  color: var(--dr-accent);
}
.strip-text {
  font: 400 19px/1.35 var(--serif);
}
.theme-night .strip-text {
  font: 400 14px/1.45 var(--mono);
}
.strip-hint {
  font: 600 10px var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dr-accent);
  white-space: nowrap;
  animation: rise 0.4s both;
}
.strip-keys {
  display: flex;
  gap: 4px;
}
.strip-keys button {
  width: 32px;
  height: 32px;
  border: 1px solid var(--dr-rule);
  background: transparent;
  color: var(--dr-muted);
  border-radius: 2px;
}
.strip-keys button:hover:not(:disabled) {
  color: var(--dr-ink);
  border-color: var(--dr-muted);
}
.strip-keys button:disabled {
  opacity: 0.25;
}

/* recall */
.key {
  display: inline-block;
  padding: 0 6px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 2px;
}
.key-hit {
  background: var(--dr-ink);
  color: var(--dr-bg);
}
.key-near {
  border: 1.5px solid var(--dr-accent);
  color: var(--dr-accent);
}
.key-miss {
  color: var(--dr-muted);
  opacity: 0.6;
  border: 1px dashed var(--dr-rule);
}
.puzzle {
  display: grid;
  gap: 18px;
}
.recall-sentence {
  margin: 0;
  font: 400 clamp(24px, 3vw, 34px) / 1.5 var(--serif);
  color: var(--dr-ink);
}
.theme-night .recall-sentence {
  font: 400 clamp(17px, 2vw, 22px) / 1.7 var(--mono);
}
.gap {
  display: inline-flex;
  gap: 3px;
  vertical-align: middle;
  margin: 0 4px;
  cursor: text;
}
.gap.is-filled {
  display: inline;
  font-style: italic;
  color: var(--dr-accent);
  border-bottom: 2px solid var(--dr-accent);
  animation: develop-in 1.2s var(--ease) both;
  margin: 0;
}
.gap.is-shake {
  animation: shake 0.35s;
}
.tile {
  display: inline-grid;
  place-items: center;
  width: 1.15em;
  height: 1.35em;
  font: 600 0.62em var(--sans);
  border-bottom: 2px solid var(--dr-muted);
  text-transform: uppercase;
}
.tile.is-caret {
  border-bottom-color: var(--dr-accent);
  animation: blink 1s steps(2) infinite;
}
.tile-hint {
  opacity: 0.5;
}
.recall-form {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.recall-input {
  flex: 1;
  min-width: 160px;
  max-width: 320px;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--dr-muted);
  color: var(--dr-ink);
  font: 500 20px var(--sans);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  padding: 8px 2px;
  outline: none;
}
.recall-input:focus {
  border-bottom-color: var(--dr-accent);
}
.recall-input::placeholder {
  letter-spacing: 0.05em;
  text-transform: none;
  color: var(--dr-muted);
  opacity: 0.6;
}
.guesses {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 6px;
}
.guess-row {
  display: flex;
  gap: 5px;
}
.guess-row .tile {
  width: 34px;
  height: 38px;
  font-size: 16px;
  border: 1px solid var(--dr-rule);
  border-radius: 2px;
  animation: flip 0.5s var(--ease) both;
}
.tile-hit {
  background: var(--dr-ink);
  color: var(--dr-bg);
  border-color: var(--dr-ink) !important;
}
.tile-near {
  border: 2px solid var(--dr-accent) !important;
  color: var(--dr-accent);
}
.tile-miss {
  color: var(--dr-muted);
  opacity: 0.45;
}
.recall-hints {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}
.recall-context {
  font: italic 18px/1.5 var(--serif);
  color: var(--dr-muted);
  border-left: 2px solid var(--dr-rule);
  padding-left: 14px;
}

/* ledger */
.ledger {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 26px;
}
.ledger-item {
  display: grid;
  gap: 12px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--dr-rule);
  transition: opacity 0.4s;
}
.ledger-item.is-skipped {
  opacity: 0.4;
}
.ledger-card {
  position: relative;
  background: #ece4d5;
  color: var(--ink);
  padding: 22px 24px 18px;
  display: grid;
  gap: 10px;
  background-image: repeating-linear-gradient(0deg, transparent 0 31px, rgba(80, 110, 150, 0.18) 31px 32px);
  box-shadow: 0 20px 30px -24px rgba(0, 0, 0, 0.9);
}
.ledger-card .voice {
  color: var(--ink-3);
}
.ledger-card .stamp-mark {
  position: absolute;
  right: 16px;
  bottom: 12px;
  background: rgba(236, 228, 213, 0.6);
}
.ledger-card .stamp-kept {
  color: var(--olive);
}
.ledger-card .stamp-changed {
  color: var(--terra);
}
.ledger-card .stamp-trying {
  color: var(--burgundy);
}
.bath .stamp-btn {
  color: var(--dr-muted);
}
.bath .stamp-btn:hover {
  color: var(--dr-ink);
}
.bath .stamp-btn.is-on {
  color: var(--paper);
}
.ledger-note input {
  width: 100%;
  background: transparent;
  border: 0;
  border-bottom: 1px dashed var(--dr-muted);
  color: var(--dr-accent);
  font: italic 19px var(--serif);
  padding: 8px 0;
  outline: none;
}

/* meeting & letters */
.meeting {
  gap: 22px;
}
.chain {
  display: grid;
  gap: 10px;
}
.reader {
  display: grid;
  gap: 16px;
}
.reader-intro {
  display: grid;
  gap: 4px;
  animation: rise 1s var(--ease) both;
}
.letter {
  background: #ede5d6;
  color: var(--ink);
  padding: clamp(22px, 3vw, 38px);
  position: relative;
  box-shadow: 0 30px 50px -36px rgba(0, 0, 0, 0.9);
  display: grid;
  gap: 14px;
}
.letter-dark {
  background: #ece3d1;
}
.theme-night .letter-dark {
  background: #e6e3d8;
}
.letter-head {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font: 500 11px var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-3);
  border-bottom: 1px solid #d4c7b2;
  padding-bottom: 10px;
}
.letter-toggle {
  background: none;
  border: 0;
  border-bottom: 0;
  padding: 0;
  width: 100%;
  text-align: left;
}
.letter-past {
  padding: 16px 22px;
  opacity: 0.86;
  gap: 10px;
}
.letter-past.is-open {
  opacity: 1;
}
.letter-p {
  font: 400 clamp(19px, 2.1vw, 23px) / 1.5 var(--serif);
  white-space: pre-line;
  animation: ink 1.4s var(--ease) both;
}
.reader-next {
  justify-self: start;
  background: none;
  border: 1px solid var(--ink-3);
  color: var(--ink-2);
  padding: 10px 16px;
  font: italic 500 18px var(--serif);
  display: inline-flex;
  gap: 14px;
  align-items: baseline;
}
.reader-next:hover {
  border-color: var(--ink);
  color: var(--ink);
}
.reader-count {
  font: 500 11px var(--mono);
  color: var(--ink-3);
}
.sealed {
  display: flex;
  gap: 16px;
  align-items: center;
  padding: 18px 20px;
  border: 1px dashed var(--dr-rule, var(--rule));
}
.sealed-title {
  font: italic 500 20px var(--serif);
}
.sealed-meta {
  font-size: 13px;
  color: var(--dr-muted, var(--ink-3));
}
.unopened {
  display: flex;
  gap: 14px;
  align-items: center;
  flex-wrap: wrap;
  padding: 16px 18px;
  border: 1px solid var(--dr-rule, var(--rule));
  font: italic 18px var(--serif);
}

.composer {
  display: grid;
  gap: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--dr-rule);
  animation: rise 0.8s var(--ease) both;
}
.composer-title {
  font: italic 500 30px var(--serif);
}
.composer-dir,
.composer-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.darkroom .chip,
.dark-slab .chip {
  border-color: var(--dr-rule);
  color: var(--dr-muted);
}
.darkroom .chip.is-on,
.dark-slab .chip.is-on {
  background: var(--dr-ink);
  color: var(--dr-bg);
  border-color: var(--dr-ink);
}
.prompt {
  background: none;
  border: 1px dashed var(--dr-rule);
  color: var(--dr-muted);
  padding: 8px 12px;
  font-size: 13px;
  text-align: left;
  border-radius: 2px;
}
.prompt:hover,
.prompt.is-on {
  color: var(--dr-ink);
  border-color: var(--dr-muted);
}
.composer-text {
  width: 100%;
  background: #ece3d1;
  color: var(--ink);
  border: 0;
  padding: 18px 20px;
  font: 400 20px/1.55 var(--serif);
  resize: vertical;
  min-height: 160px;
  background-image: repeating-linear-gradient(0deg, transparent 0 30px, rgba(80, 110, 150, 0.14) 30px 31px);
  background-position: 0 14px;
  outline: none;
}
.composer-text:focus {
  box-shadow: 0 0 0 2px var(--dr-accent);
}
.composer-note {
  font-size: 13px;
  color: var(--dr-muted);
}
.seal-picker {
  border: 0;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}
.seal-picker legend {
  font: 600 11px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 10px;
}
.seal-picker.is-dark legend {
  color: var(--dr-muted);
}
.seal-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.seal-date {
  display: flex;
  gap: 10px;
  align-items: center;
  font-size: 14px;
}
.seal-date input {
  background: transparent;
  border: 1px solid var(--dr-rule, var(--rule));
  padding: 8px 10px;
  color-scheme: light dark;
}
.sent {
  display: grid;
  gap: 16px;
  justify-items: start;
  animation: rise 0.8s var(--ease) both;
}

/* fixed */
.fixed {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  gap: clamp(24px, 4vw, 60px);
  align-items: center;
  max-width: 1180px;
  margin: 20px auto 0;
}
.fixed-print {
  background: #f4efe6;
  padding: clamp(14px, 2vw, 26px) clamp(14px, 2vw, 26px) clamp(46px, 6vw, 70px);
  transform: rotate(-1.5deg);
  box-shadow: 0 40px 60px -30px rgba(0, 0, 0, 0.9);
  animation: lift 1.6s var(--ease) both;
}
.fixed-text {
  display: grid;
  gap: 16px;
}
.fixed-text h2 {
  font: 500 clamp(40px, 5vw, 64px) / 1 var(--serif);
}
.fixed-text p {
  color: var(--dr-muted);
}
.fixed-text .kicker {
  color: var(--dr-accent);
}

/* arrival */
.arrival-body {
  max-width: 760px;
  margin: 40px auto 0;
  display: grid;
  gap: 24px;
}
.arrival-next {
  display: flex;
  gap: 20px;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 10px;
}

/* ==========================================================================
   PRINT (a developed memory)
   ========================================================================== */
.print-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  padding: 14px 0;
  border-bottom: 1px solid var(--ink);
}
.print-actions {
  display: flex;
  gap: 20px;
  align-items: center;
  flex-wrap: wrap;
}
.print-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
  gap: clamp(24px, 4vw, 60px);
  margin-top: 36px;
  align-items: start;
}
.print-photo-wrap {
  background: #fffdf8;
  padding: clamp(10px, 1.6vw, 20px) clamp(10px, 1.6vw, 20px) clamp(10px, 1.6vw, 20px);
  box-shadow: 0 30px 50px -36px rgba(38, 34, 30, 0.7);
  position: relative;
}
.print-undeveloped {
  position: absolute;
  inset: auto 0 0 0;
  margin: auto;
  width: max-content;
  bottom: 40%;
  background: var(--ink);
  color: var(--paper);
  padding: 10px 16px;
  text-decoration: none;
  font-size: 14px;
}
.contact {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  overflow-x: auto;
  background: #1c1916;
  padding: 8px;
}
.contact-frame {
  flex: none;
  width: 92px;
  background: none;
  border: 0;
  padding: 0;
  opacity: 0.55;
  color: #d3c4a8;
  font: 500 10px var(--mono);
  text-align: left;
}
.contact-frame.is-on {
  opacity: 1;
  outline: 1px solid #d3c4a8;
}
.print-dateline {
  font: italic 500 18px var(--serif);
  color: var(--ink-2);
}
.print-title {
  font: 500 clamp(46px, 6.4vw, 92px) / 0.95 var(--serif);
  letter-spacing: -0.015em;
  margin: 10px 0 24px;
}
.print-meta {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8px 18px;
  margin: 0 0 26px;
  font-size: 15px;
}
.print-meta dt {
  font: 600 10px/2 var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.print-meta dd {
  margin: 0;
}
.record {
  display: flex;
  gap: 18px;
  align-items: center;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 18px 0;
}
.record-disc {
  flex: none;
  width: 74px;
  height: 74px;
  border-radius: 50%;
  background:
    radial-gradient(circle, var(--accent) 0 17%, #f3ede2 17% 19%, transparent 19%),
    repeating-radial-gradient(circle, #1c1916 0 2px, #2b2622 2px 3px);
  animation: spin calc(var(--beat, 0.8s) * 8) linear infinite;
}
.record-text {
  display: grid;
  gap: 2px;
  min-width: 0;
}
.record-k {
  font: 600 10px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.record-title {
  font: italic 500 24px/1.1 var(--serif);
}
.record-artist {
  font-size: 14px;
  color: var(--ink-2);
  margin-bottom: 8px;
}
.print-body {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  gap: clamp(28px, 5vw, 80px);
  margin-top: 64px;
  border-top: 1px solid var(--ink);
  padding-top: 32px;
}
.story {
  display: grid;
  gap: 16px;
}
.story p {
  font: 400 clamp(20px, 2vw, 23px) / 1.6 var(--serif);
}
.story-first::first-letter {
  float: left;
  font: 500 4.1em/0.82 var(--serif);
  padding: 6px 10px 0 0;
  color: var(--accent);
}
.margin {
  border-left: 1px solid var(--rule);
  padding-left: clamp(18px, 3vw, 36px);
  display: grid;
  gap: 16px;
  align-content: start;
}
.margin-h,
.print-h {
  font: 600 11px var(--sans);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-2);
}
.margin-notes {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 16px;
}
.margin-notes li {
  display: grid;
  gap: 4px;
}
.margin-form {
  display: grid;
  gap: 8px;
  justify-items: start;
}
.margin-form textarea {
  width: 100%;
  border: 0;
  border-bottom: 1px dashed var(--ink-3);
  background: transparent;
  font: italic 19px/1.4 var(--serif);
  color: var(--accent);
  padding: 6px 0;
  resize: vertical;
  outline: none;
}
.print-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(28px, 5vw, 80px);
  margin-top: 64px;
}
.print-grid > div {
  display: grid;
  gap: 16px;
  align-content: start;
}
.timeline {
  list-style: none;
  padding: 0;
  margin: 0;
  border-left: 1px solid var(--ink);
}
.timeline li {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 10px;
  padding: 8px 0 8px 16px;
  position: relative;
  font: 400 18px/1.4 var(--serif);
}
.timeline li::before {
  content: '';
  position: absolute;
  left: -4px;
  top: 16px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
}
.timeline-t {
  font: 500 13px/1.9 var(--mono);
  color: var(--ink-3);
}
.details {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.details li {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 8px 12px;
  font: italic 500 18px var(--serif);
  transform: rotate(-0.6deg);
}
.details li:nth-child(even) {
  transform: rotate(0.8deg);
}
.print-section {
  margin-top: 64px;
  display: grid;
  gap: 18px;
}
.print-h-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.ledger-print {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
}
.ledger-print li {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 20px;
  display: grid;
  gap: 14px;
  align-content: space-between;
}
.ledger-print .quote {
  font-size: 21px;
}
.ledger-print-foot {
  display: grid;
  gap: 10px;
  justify-items: start;
}
.unstamped {
  font: 500 11px var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.dark-slab {
  --dr-bg: #1d1814;
  --dr-bg-2: #29221c;
  --dr-ink: #efe4d3;
  --dr-muted: #a89684;
  --dr-rule: rgba(239, 228, 211, 0.16);
  --dr-accent: #d3875f;
  background: var(--dr-bg);
  color: var(--dr-ink);
  padding: clamp(18px, 3vw, 34px);
  display: grid;
  gap: 14px;
}
.dark-slab:empty {
  display: none;
}
.print-foot {
  margin-top: 60px;
  border-top: 3px double var(--ink);
  padding-top: 14px;
}

/* night print: a different paper altogether */
.print.theme-night {
  --ivory: #101211;
  --paper: #171a18;
  --ink: #d5dcc4;
  --ink-2: #a8b096;
  --ink-3: #8f9984;
  --olive: #b9c98f;
  --terra: #d49a7e;
  --rule: #2c312b;
  --cream: #222621;
  background: var(--ivory);
  color: var(--ink);
  max-width: none;
}
body:has(.print.theme-night) {
  background: #101211;
}
.print.theme-night .print-title,
.print.theme-night .print-dateline {
  font-family: var(--mono);
  font-style: normal;
  letter-spacing: -0.04em;
}
.print.theme-night .print-title {
  font-size: clamp(34px, 4.6vw, 64px);
}
.print.theme-night .print-photo-wrap {
  background: #1d211e;
}
.print.theme-night .story p {
  font: 400 16px/1.8 var(--mono);
}
.print.theme-night .btn-ink {
  background: var(--ink);
  color: #101211;
}
.print.theme-paper .print-photo-wrap {
  transform: rotate(-0.8deg);
}
.print.theme-autumn .print-photo-wrap {
  transform: rotate(0.6deg);
}

/* ==========================================================================
   CREATE
   ========================================================================== */
.create {
  max-width: 980px;
}
.create-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--ink);
}
.create-head .kicker {
  margin: 0;
}
.film {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: #1c1916;
  padding: 12px 8px;
  gap: 6px;
  margin: 26px 0 36px;
  position: relative;
}
.film::before,
.film::after {
  content: '';
  position: absolute;
  left: 8px;
  right: 8px;
  height: 5px;
  background: repeating-linear-gradient(90deg, #e8decb 0 7px, transparent 7px 16px);
  opacity: 0.7;
}
.film::before {
  top: 3px;
}
.film::after {
  bottom: 3px;
}
.film-frame {
  background: #2c2621;
  border: 0;
  color: #9d8f7f;
  padding: 12px 8px;
  display: grid;
  gap: 2px;
  text-align: left;
  transition: background 0.3s, color 0.3s;
}
.film-frame.is-done {
  background: #4a3f36;
  color: #d9ccb8;
}
.film-frame.is-now {
  background: var(--ivory);
  color: var(--ink);
}
.film-n {
  font: 500 18px var(--serif);
}
.film-label {
  font: 500 11px var(--sans);
  letter-spacing: 0.06em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.form-error {
  background: #f1dcd5;
  color: var(--burgundy);
  padding: 12px 16px;
  margin-bottom: 20px;
  font-size: 14px;
}
.step {
  display: grid;
  gap: 18px;
  animation: rise 0.6s var(--ease) both;
}
.step-title {
  font: 500 clamp(40px, 5vw, 60px) / 1 var(--serif);
}
.step-sub {
  font: 500 30px var(--serif);
  margin-top: 26px;
}
.step-hint {
  color: var(--ink-2);
  max-width: 62ch;
}
.step-hint.small {
  font-size: 13px;
  color: var(--ink-3);
}
.field {
  display: grid;
  gap: 8px;
}
.field > span:first-child {
  font: 600 11px var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.field-inline {
  display: flex;
  align-items: center;
  gap: 12px;
}
.field input,
.field select,
.picker select,
.review input,
.detail-chips + form input {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 11px 12px;
  border-radius: 2px;
  width: 100%;
  min-height: 44px;
  outline: none;
}
.field-inline input {
  width: auto;
}
.field input:focus,
.review input:focus,
select:focus {
  border-color: var(--ink-2);
}
.field-dark span:first-child {
  color: var(--dr-muted);
}
.field-dark select {
  background: var(--dr-bg-2);
  color: var(--dr-ink);
  border-color: var(--dr-rule);
}
.fields-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.story-input,
.letter-input {
  width: 100%;
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: clamp(18px, 3vw, 32px);
  font: 400 clamp(20px, 2.2vw, 23px) / 1.65 var(--serif);
  resize: vertical;
  outline: none;
  min-height: 300px;
  background-image: linear-gradient(90deg, transparent 52px, rgba(122, 46, 46, 0.18) 52px 53px, transparent 53px);
}
.story-input:focus,
.letter-input:focus {
  border-color: var(--ink-3);
}
.count {
  font-size: 12px;
  color: var(--ink-3);
  min-height: 1em;
}
.uploads {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 14px;
}
.upload {
  margin: 0;
  background: #fffdf8;
  padding: 8px 8px 10px;
  box-shadow: 0 14px 24px -18px rgba(0, 0, 0, 0.6);
}
.upload img {
  aspect-ratio: 3/2;
  object-fit: cover;
  width: 100%;
  background: var(--cream);
}
.upload figcaption {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  flex-wrap: wrap;
  font: italic 15px var(--serif);
  color: var(--ink-3);
  padding-top: 6px;
}
.upload figcaption span {
  display: flex;
  gap: 10px;
}
.upload .link {
  font: 12px var(--sans);
}
.drop {
  display: grid;
  place-items: center;
  align-content: center;
  gap: 2px;
  min-height: 150px;
  border: 1px dashed var(--ink-3);
  cursor: pointer;
  text-align: center;
  font: italic 500 19px var(--serif);
  color: var(--ink-2);
  transition: background 0.2s;
}
.drop:hover,
.drop.is-over {
  background: var(--paper);
  color: var(--burgundy);
}
.drop:has(input:focus-visible) {
  outline: 2px solid var(--accent);
}
.drop-plus {
  font: 300 40px/1 var(--serif);
}
.drop-sub {
  font: 12px var(--sans);
  color: var(--ink-3);
}
.file-field input[type='file'] {
  padding: 10px;
}
.file-chosen {
  font-size: 13px;
  color: var(--ink-2);
}
.field input + .chips,
.chips + input {
  margin-top: 4px;
}
.review {
  border-top: 1px solid var(--rule);
  padding-top: 22px;
  display: grid;
  gap: 12px;
}
.review-h {
  font: 500 28px var(--serif);
}
.review-sub {
  font-size: 13px;
  color: var(--ink-3);
}
.edit-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
}
.edit-row {
  display: grid;
  grid-template-columns: 90px 1fr auto;
  gap: 8px;
  align-items: center;
}
.edit-row .edit-text {
  font: 18px var(--serif);
}
.edit-time {
  font: 13px var(--mono) !important;
}
.edit-tools {
  display: flex;
  gap: 4px;
}
.edit-tools button {
  width: 36px;
  height: 36px;
  border: 1px solid var(--rule);
  background: var(--paper);
}
.edit-tools button:disabled {
  opacity: 0.3;
}
.thread-kind {
  font: 500 22px var(--serif);
  color: var(--accent);
  text-align: center;
}
.edit-quote {
  font: italic 19px/1.4 var(--serif);
}
.recall-edit {
  display: flex;
  gap: 12px;
  align-items: baseline;
  justify-content: space-between;
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 12px 14px;
}
.recall-edit-s {
  font: 19px/1.7 var(--serif);
}
.word {
  background: none;
  border: 0;
  padding: 0 1px;
  font: inherit;
  border-bottom: 1px dotted var(--ink-3);
}
.word:hover {
  color: var(--burgundy);
}
.word.is-on {
  background: var(--ink);
  color: var(--paper);
  padding: 0 4px;
  border-bottom: 0;
}
.picker {
  display: flex;
  gap: 10px;
  align-items: center;
  font-size: 14px;
  color: var(--burgundy);
  flex-wrap: wrap;
}
.picker select {
  flex: 1;
  min-width: 200px;
  width: auto;
}
.detail-chips {
  list-style: none;
  padding: 0;
  margin: 0 0 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.detail-chips li {
  display: inline-flex;
  gap: 8px;
  align-items: center;
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 6px 6px 6px 12px;
  font: italic 17px var(--serif);
}
.detail-chips button {
  border: 0;
  background: none;
  width: 28px;
  height: 28px;
  color: var(--ink-3);
}
.detail-chips + form input {
  flex: 1;
  min-width: 200px;
  width: auto;
}
.theme-pick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.theme-swatch {
  display: grid;
  gap: 4px;
  text-align: left;
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 12px;
  font-size: 12px;
  color: var(--ink-3);
}
.theme-swatch strong {
  font: 500 20px var(--serif);
  color: var(--ink);
}
.theme-swatch.is-on {
  border-color: var(--ink);
  box-shadow: inset 0 0 0 1px var(--ink);
}
.swatch {
  height: 44px;
  margin-bottom: 6px;
}
.theme-swatch.theme-autumn .swatch {
  background: radial-gradient(ellipse at 50% 0, #a03422 0, #17110d 75%);
}
.theme-swatch.theme-paper .swatch {
  background: radial-gradient(ellipse at 50% 0, #e4c88e 0, #12151b 75%);
}
.theme-swatch.theme-night .swatch {
  background: repeating-linear-gradient(0deg, #0b0d0c 0 2px, #1a211c 2px 3px), #0b0d0c;
  box-shadow: inset 0 0 20px #b9c98f55;
}
.baths-preview {
  font: italic 19px var(--serif);
  color: var(--ink-2);
  border-top: 3px double var(--ink);
  padding-top: 16px;
}
.create-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 40px;
  padding-top: 18px;
  border-top: 1px solid var(--ink);
  position: sticky;
  bottom: 0;
  background: var(--ivory);
  padding-bottom: 14px;
  z-index: 5;
}

/* hung */
.hung {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(28px, 5vw, 70px);
  align-items: center;
  padding-top: 80px;
}
.hung-pin {
  position: relative;
  animation: swing 3s ease-in-out both;
  transform-origin: 50% 0;
}
.hung-frame {
  background: #1c1916;
  padding: 18px 12px;
}
.hung-text {
  display: grid;
  gap: 16px;
}
.hung-text h1 {
  font: 500 clamp(40px, 5vw, 60px) / 1 var(--serif);
}
.hung-text p {
  color: var(--ink-2);
}

/* letters page */
.letters-page {
  max-width: 900px;
}
.letters-head {
  padding: 40px 0 10px;
}
.write-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin: 18px 0;
}
.write-slab {
  margin-bottom: 20px;
}
.flash {
  margin: 10px 0 20px;
}
.letter-group {
  margin-top: 40px;
  display: grid;
  gap: 12px;
}
.letter-group-head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  border-bottom: 1px solid var(--ink);
  padding-bottom: 8px;
  flex-wrap: wrap;
}
.letter-group-title {
  font: 500 26px var(--serif);
  text-decoration: none;
}
a.letter-group-title:hover {
  color: var(--burgundy);
}
.letter-row {
  display: grid;
  gap: 6px;
}
.letter-edit-btn {
  justify-self: start;
  font-size: 12px;
}
.letter-edit {
  display: grid;
  gap: 10px;
}
.empty {
  padding: 80px 0 20px;
  font: italic 24px var(--serif);
}

/* ==========================================================================
   MOTION
   ========================================================================== */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
}
@keyframes lights-off {
  from {
    background-color: #f3ede2;
  }
}
@keyframes breathe {
  50% {
    opacity: 0.4;
  }
}
@keyframes grain {
  0% {
    transform: translate(0, 0);
  }
  20% {
    transform: translate(-6%, 4%);
  }
  40% {
    transform: translate(4%, -8%);
  }
  60% {
    transform: translate(-10%, 2%);
  }
  80% {
    transform: translate(8%, 6%);
  }
}
@keyframes rock {
  0%,
  100% {
    transform: rotateX(2deg) rotateZ(-0.35deg);
  }
  50% {
    transform: rotateX(-2deg) rotateZ(0.35deg);
  }
}
@keyframes sheen {
  0%,
  100% {
    background-position: 100% 0;
  }
  50% {
    background-position: 0 0;
  }
}
@keyframes pulse {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0.55;
  }
}
@keyframes flicker {
  50% {
    opacity: 0.94;
  }
}
@keyframes develop-in {
  from {
    opacity: 0;
    filter: blur(4px);
  }
}
@keyframes ink {
  from {
    opacity: 0;
    filter: blur(3px);
    transform: translateY(4px);
  }
}
@keyframes fix {
  40% {
    transform: scale(1.015);
  }
}
@keyframes flip {
  from {
    transform: rotateX(90deg);
    opacity: 0;
  }
}
@keyframes shake {
  25% {
    transform: translateX(-6px);
  }
  75% {
    transform: translateX(6px);
  }
}
@keyframes blink {
  50% {
    border-bottom-color: transparent;
  }
}
@keyframes bar {
  from {
    height: 3px;
  }
  to {
    height: 14px;
  }
}
@keyframes stamp {
  from {
    transform: rotate(-14deg) scale(1.8);
    opacity: 0;
  }
}
@keyframes lift {
  from {
    transform: rotate(0) translateY(30px) scale(0.96);
    filter: brightness(0.4);
  }
}
@keyframes wiggle {
  0%,
  100% {
    transform: rotate(-4deg);
  }
  50% {
    transform: rotate(-2deg) translateY(-3px);
  }
}
@keyframes swing {
  0% {
    transform: rotate(6deg);
  }
  30% {
    transform: rotate(-3deg);
  }
  60% {
    transform: rotate(1.5deg);
  }
  100% {
    transform: rotate(0);
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================================================
   SMALL SCREENS
   ========================================================================== */
@media (max-width: 860px) {
  .bath,
  .bath-sequence,
  .bath-recall,
  .bath-ledger,
  .bath-meeting,
  .fixed,
  .print-hero,
  .print-body,
  .print-grid,
  .hung {
    grid-template-columns: minmax(0, 1fr);
  }
  .bath-visual {
    position: relative;
    top: 0;
  }
  .bath-sequence .bath-visual,
  .bath-recall .bath-visual,
  .bath-ledger .bath-visual,
  .bath-meeting .bath-visual {
    max-width: 300px;
    margin: 0 auto;
    width: 70%;
  }
  .margin {
    border-left: 0;
    padding-left: 0;
    border-top: 1px solid var(--rule);
    padding-top: 22px;
  }
  .howto {
    grid-template-columns: 1fr;
  }
  .howto li,
  .howto li + li {
    padding: 14px 0;
    border-left: 0;
  }
  .howto li + li {
    border-top: 1px solid var(--rule);
  }
  .colophon {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .masthead-rule {
    grid-template-columns: 1fr auto;
  }
  .masthead-date {
    display: none;
  }
  .masthead-nav {
    gap: 12px;
    font-size: 11px;
  }
  .arrived {
    grid-template-columns: 1fr;
    gap: 22px;
  }
  .envelope {
    width: 150px;
    height: 100px;
  }
  .dr-head {
    grid-template-columns: auto 1fr;
  }
  .dr-title {
    text-align: right;
  }
  .dr-head > :last-child {
    grid-column: 1 / -1;
    justify-self: stretch;
  }
  .dr-head .sound-btn {
    max-width: none;
    width: 100%;
  }
  .dr-head .sound-song {
    max-width: none;
  }
  .dr-baths {
    justify-content: flex-start;
    margin: 14px 0 18px;
  }
  .dr-baths li {
    padding: 4px 8px;
  }
  .dr-baths li:not(.is-now) .dr-bath-name {
    display: none;
  }
  .strip {
    grid-template-columns: 26px 1fr auto;
    grid-template-areas: 'h t k' 'h x k' 'h hint k';
    gap: 2px 10px;
  }
  .strip-handle {
    grid-area: h;
  }
  .strip-time {
    grid-area: t;
    font-size: 12px;
  }
  .strip-text {
    grid-area: x;
    font-size: 17px;
  }
  .strip-hint {
    grid-area: hint;
  }
  .strip-keys {
    grid-area: k;
    flex-direction: column;
  }
  .strip-keys button {
    width: 38px;
    height: 38px;
  }
  .fields-2,
  .theme-pick {
    grid-template-columns: 1fr;
  }
  .film {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .film-label {
    display: none;
  }
  .film-frame {
    text-align: center;
  }
  .edit-row {
    grid-template-columns: 70px 1fr;
  }
  .edit-row .edit-tools,
  .edit-row > .link {
    grid-column: 1 / -1;
    justify-self: end;
  }
  .toc-date {
    min-width: 0;
    display: none;
  }
  .print-bar .print-actions {
    gap: 14px;
  }
  .guess-row .tile {
    width: 28px;
    height: 34px;
    font-size: 14px;
  }
  .spot {
    font-size: 11px;
    padding: 4px 6px;
