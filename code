const REDRAW_CHARS = 80

async function downscale(file: File): Promise<Blob> {
  if (!file.type.startsWith('image/') || file.type === 'image/gif' || file.type === 'image/svg+xml') return file
  try {
    const bmp = await createImageBitmap(file)
    const max = 2000
    const k = Math.min(1, max / Math.max(bmp.width, bmp.height))
    if (k === 1 && file.size < 2_500_000) return file
    const c = document.createElement('canvas')
    c.width = Math.round(bmp.width * k)
    c.height = Math.round(bmp.height * k)
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height)
    return await new Promise<Blob>((res) => c.toBlob((b) => res(b ?? file), 'image/jpeg', 0.88))
  } catch {
    return file
  }
}

function ExistingPhoto({ id, onUrl }: { id: string; onUrl: (u: string) => void }) {
  const u = useBlobUrl(id)
  useEffect(() => {
    if (u) onUrl(u)
  }, [u, onUrl])
  return null
}

export default function Create({ editId, fromDate }: { editId?: string; fromDate?: string }) {
  const { memories, shoebox } = useStore()
  const editing = editId ? memories.find((m) => m.id === editId) : undefined
  // starting from a journal day: its photos, and the captions you wrote for them
  const shots = fromDate ? shoebox.filter((x) => x.date === fromDate) : []
  const shotStory = [...new Set(shots.map((x) => x.caption).filter(Boolean))].join('\n')
  const shotTime = shots[0] ? new Date(shots[0].takenAt).toTimeString().slice(0, 5) : ''
  const [step, setStep] = useState(0)
  const [saved, setSaved] = useState<Memory | null>(null)
  const [busy, setBusy] = useState(false)
  const [err, setErr] = useState('')

  // 1
  const [date, setDate] = useState(editing?.date ?? fromDate ?? todayISO())
  const [story, setStory] = useState(editing?.story ?? shotStory)
  const [title, setTitle] = useState(editing?.title ?? '')
  // 2
  const [photos, setPhotos] = useState<PhotoItem[]>(() => editing?.photoIds.map((id) => ({ id, url: '' })) ?? shots.slice(0, 12).map((x) => ({ id: x.blobId, url: '' })))
  const [song, setSong] = useState({ title: editing?.song?.title ?? '', artist: editing?.song?.artist ?? '', url: editing?.song?.url ?? '' })
  const [tempo, setTempo] = useState<Tempo>(editing?.song?.tempo ?? 'slow')
  const [audio, setAudio] = useState<{ id?: string; file?: File } | null>(editing?.song?.audioId ? { id: editing.song.audioId } : null)
  // what is known about the song: typed in, or measured from the file on this device
  const [facts, setFacts] = useState({
    bpm: editing?.song?.bpm ? String(editing.song.bpm) : '',
    mode: editing?.song?.mode ?? ('' as '' | 'major' | 'minor'),
    genre: editing?.song?.genre ?? '',
    year: editing?.song?.year ? String(editing.song.year) : '',
    energy: editing?.song?.energy,
    brightness: editing?.song?.brightness,
  })
  const [hearing, setHearing] = useState<'idle' | 'listening' | 'heard' | 'failed'>(editing?.song?.energy !== undefined ? 'heard' : 'idle')
  const chooseAudio = async (file: File) => {
    setAudio({ file })
    setHearing('listening')
    const h = await listen(file)
    if (!h) return setHearing('failed')
    setFacts((f) => ({ ...f, bpm: String(h.bpm), energy: h.energy, brightness: h.brightness }))
    setTempo(tempoOf(h.bpm))
    setHearing('heard')
  }
  const dropAudio = () => {
    setAudio(null)
    if (hearing === 'heard') setFacts((f) => ({ ...f, bpm: '', energy: undefined, brightness: undefined }))
    setHearing('idle')
  }
  // 3
  const [time, setTime] = useState(editing?.time ?? shotTime)
  const [location, setLocation] = useState(editing?.location ?? '')
  const [people, setPeople] = useState(editing?.people.join(', ') ?? '')
  const [weather, setWeather] = useState(editing?.weather ?? '')
  const [mood, setMood] = useState(editing?.mood ?? '')
  // 4
  const [extractedFor, setExtractedFor] = useState(editing?.story ?? '')
  const [moments, setMoments] = useState<Moment[]>(editing?.moments ?? [])
  const [recall, setRecall] = useState<RecallItem[]>(editing?.recall ?? [])
  const [threads, setThreads] = useState<Thread[]>(editing?.threads ?? [])
  const [details, setDetails] = useState<string[]>(editing?.details ?? [])
  const [theme, setTheme] = useState<Theme | null>(editing?.theme ?? null)
  // 5
  const [letter, setLetter] = useState('')
  const [seal, setSeal] = useState<SealChoice>('develop')
  const [sealDate, setSealDate] = useState('')

  // a picture drawn from the story while it's being written (new days only)
  const [drawOn, setDrawOn] = useState(() => !editing && drawPref())
  const [drawing, setDrawing] = useState(false)
  const [drawErr, setDrawErr] = useState('')
  const drawnFor = useRef('')
  const drawAbort = useRef<AbortController | null>(null)
  const drawnItem = photos.find((p) => p.drawn)

  const drawNow = async () => {
    drawAbort.current?.abort()
    const ac = new AbortController()
    drawAbort.current = ac
    const words = story.trim()
    drawnFor.current = words
    setDrawing(true)
    setDrawErr('')
    try {
      const { blob } = await drawFromWords({ story: words, title: title || undefined, place: location || undefined, time: time || undefined, weather: weather || undefined, mood: mood || undefined, date }, ac.signal)
      if (ac.signal.aborted) return
      const item: PhotoItem = { file: new File([blob], 'drawn-from-words.jpg', { type: 'image/jpeg' }), url: URL.createObjectURL(blob), drawn: true }
      setPhotos((ps) => {
        for (const p of ps) if (p.drawn) URL.revokeObjectURL(p.url)
        const rest = ps.filter((p) => !p.drawn)
        return rest.length ? [...rest, item] : [item]
      })
    } catch (e) {
      if (!ac.signal.aborted) setDrawErr(e instanceof Error ? e.message : String(e))
    } finally {
      if (drawAbort.current === ac) setDrawing(false)
    }
  }

  const removeDrawn = () => {
    drawAbort.current?.abort()
    setDrawing(false)
    setPhotos((ps) => ps.filter((p) => !p.drawn))
  }

  // draw once the writer pauses; redraw only when the story has grown or changed a lot
  useEffect(() => {
    if (!drawOn || editing) return
    const words = story.trim()
    if (words.split(/\s+/).length < DRAW_MIN_WORDS) return
    const last = drawnFor.current
    if (last && Math.abs(words.length - last.length) < REDRAW_CHARS && words.slice(0, 200) === last.slice(0, 200)) return
    const t = window.setTimeout(drawNow, DRAW_AFTER_MS)
    return () => window.clearTimeout(t)
    // drawNow reads the latest fields; only the story should restart the timer
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [story, drawOn, editing])

  useEffect(() => () => drawAbort.current?.abort(), [])

  const ss = useMemo(() => sentences(story), [story])
  // the system names the day's folder first; the older title ideas follow
  const titles = useMemo(() => {
    const named = story.trim() ? folderName({ story, date, time: time || undefined, location: location || undefined }) : ''
    return [...new Set([named, ...suggestTitles(story, location || undefined, date)].filter(Boolean))]
  }, [story, location, date, time])
  const songFacts = () => {
    const bpm = Math.round(Number(facts.bpm))
    const year = Math.round(Number(facts.year))
    return {
      bpm: bpm >= 40 && bpm <= 240 ? bpm : undefined,
      mode: facts.mode || undefined,
      genre: facts.genre.trim() || undefined,
      year: year >= 1900 && year <= new Date().getFullYear() ? year : undefined,
      energy: facts.energy,
      brightness: facts.brightness,
    }
  }
  // the page the day will get, worked out live from what has been entered so far
  const [firstSwatches, setFirstSwatches] = useState<Swatch[] | undefined>()
  const firstUrl = photos[0]?.url
  useEffect(() => {
    let live = true
    if (!firstUrl) setFirstSwatches(undefined)
    else swatches(firstUrl).then((x) => live && setFirstSwatches(x.length ? x : undefined))
    return () => {
      live = false
    }
  }, [firstUrl])
  const preview = useMemo(
    () =>
      atmosphere({
        story,
        date,
        time: time || undefined,
        weather: weather || undefined,
        mood: mood || undefined,
        location: location || undefined,
        people: people.split(',').map((x) => x.trim()).filter(Boolean),
        song: song.title.trim() ? { title: song.title, artist: song.artist, tempo, ...songFacts() } : undefined,
        photoCount: Math.max(1, photos.length),
        swatches: firstSwatches,
      }),
    // songFacts reads facts
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [story, date, time, weather, mood, location, people, song.title, song.artist, tempo, facts, photos.length, firstSwatches],
  )
  // the darkroom's light follows the same rules as the page, so a day looks like itself everywhere
  const autoTheme: Theme = ({ monet: 'autumn', collage: 'autumn', film: 'paper', ma: 'paper', kandinsky: 'night' } as const)[preview.technique]
  const chosenTheme = theme ?? autoTheme

  const runReader = () => {
    setMoments(extractMoments(story))
    const th = extractThreads(story)
    setThreads(th)
    setRecall(extractRecall(story, 3, th.map((t) => t.quote)))
    setExtractedFor(story)
  }

  const goto = (n: number) => {
    setErr('')
    if (n > 0 && !story.trim()) {
      setErr('Write at least a few words about the day first — everything else grows from them.')
      setStep(0)
      return
    }
    if (n >= 3 && extractedFor !== story && !(editing && n === 4)) runReader()
    setStep(n)
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const save = async () => {
    if (!story.trim()) return goto(0)
    if (letter.trim() && seal === 'date' && !sealDate) {
      setErr('Choose the date the letter should open.')
      return
    }
    setBusy(true)
    try {
      const photoIds: string[] = []
      for (const p of photos) photoIds.push(p.id ?? (await putBlob(await downscale(p.file!))))
      let audioId = audio?.id
      if (audio?.file) audioId = await putBlob(audio.file)
      const t = chosenTheme
      let base = { details, moments, recall, threads }
      if (extractedFor !== story && !editing) {
        const th = extractThreads(story)
        base = { details, moments: extractMoments(story), threads: th, recall: extractRecall(story, 3, th.map((x) => x.quote)) }
      }
      const baths = bathsFor(base)
      const m: Memory = {
        id: editing?.id ?? uid('m_'),
        demo: editing?.demo,
        title: title.trim() || titles[0] || 'Untitled day',
        date,
        time: time || undefined,
        location: location.trim() || undefined,
        people: people.split(',').map((x) => x.trim()).filter(Boolean),
        weather: weather.trim() || undefined,
        mood: mood.trim() || undefined,
        story: story.trim(),
        photoIds,
        art: photoIds.length ? undefined : editing?.art,
        song: song.title.trim() ? { title: song.title.trim(), artist: song.artist.trim() || 'Unknown artist', url: song.url.trim() || undefined, audioId, tempo, ...songFacts() } : undefined,
        ...base,
        theme: t,
        cover: coverFor(t) as Cover,
        baths,
        createdAt: editing?.createdAt ?? new Date().toISOString(),
        progress: editing
          ? { done: Object.fromEntries(Object.entries(editing.progress.done).filter(([k]) => baths.includes(k as never))), developedAt: editing.progress.developedAt }
          : { done: {} },
        ledger: editing?.ledger ?? {},
        margin: editing?.margin ?? [],
      }
      await saveMemory(m)
      if (letter.trim()) {
        await saveLetter({
          id: uid('l_'),
          memoryId: m.id,
          to: 'future',
          body: letter.trim(),
          writtenAt: new Date().toISOString(),
          sealedUntil: sealToDate(seal, sealDate),
        })
      }
      setSaved(m)
      window.scrollTo({ top: 0 })
    } catch (e) {
      setErr('Something went wrong while saving: ' + String(e) + '. Your words are still here — try again.')
    } finally {
      setBusy(false)
    }
  }

  if (saved) return <Hung m={saved} edited={!!editing} />

  return (
    <main className="paper create">
      <header className="create-head">
        <Back href={editing ? `#/print/${editing.id}` : '#/today'}>{editing ? 'Back to the print' : 'Cancel'}</Back>
        <p className="kicker">{editing ? 'Retouching' : 'Exposing a new day'}</p>
      </header>

      <nav className="film" aria-label="Steps">
        {STEPS.map((s, i) => (
          <button key={s} type="button" className={`film-frame ${i === step ? 'is-now' : ''} ${i < step ? 'is-done' : ''}`} onClick={() => goto(i)} aria-current={i === step ? 'step' : undefined}>
            <span className="film-n">{roman(i + 1)}</span>
            <span className="film-label">{s}</span>
          </button>
        ))}
      </nav>

      {err && (
        <p className="form-error" role="alert">
          {err}
        </p>
      )}

      <div className="create-body">
        {step === 0 && (
          <section className="step">
            <h1 className="step-title">
              What happened? <InfoTip>Write it the way you’d tell a friend at midnight. Times (“at 4pm”, “23:40”), plans and questions are especially welcome — they become the game later.</InfoTip>
            </h1>
            <label className="field field-inline">
              <span>The date</span>
              <input type="date" value={date} max={todayISO()} onChange={(e) => setDate(e.target.value)} />
            </label>
            <label className="field">
              <span className="sr-only">The story of the day</span>
              <textarea className="story-input" rows={12} value={story} onChange={(e) => setStory(e.target.value)} placeholder="We met at the gate at 2pm…" autoFocus />
            </label>
            <p className="count">{story.trim() ? `${story.trim().split(/\s+/).length} words · ${ss.length} sentences` : ''}</p>

            {!editing && (
              <div className="drawn" aria-live="polite">
                {(drawing || drawnItem) && (
                  <figure className={`drawn-frame ${drawing ? 'is-drawing' : ''}`}>
                    {drawnItem ? <img src={drawnItem.url} alt="A picture drawn from your story" /> : <div className="drawn-empty" />}
                    <figcaption>
                      <span>
                        <span className="app-mark" aria-hidden="true">
                          ◇
                        </span>{' '}
                        {drawing ? 'Drawing a picture from your words…' : 'Drawn from your words, not a photograph. It will be kept with this day.'}
                      </span>
                      {drawnItem && !drawing && (
                        <span>
                          <button type="button" className="link" onClick={drawNow}>
                            draw again
                          </button>
                          <button type="button" className="link danger" onClick={removeDrawn}>
                            remove
                          </button>
                        </span>
                      )}
                    </figcaption>
                  </figure>
                )}
                {drawErr && !drawing && (
                  <p className="drawn-err">
                    {drawErr}{' '}
                    <button type="button" className="link" onClick={drawNow}>
                      try again
                    </button>
                  </p>
                )}
                <label className="drawn-toggle">
                  <input
                    type="checkbox"
                    checked={drawOn}
                    onChange={(e) => {
                      setDrawOn(e.target.checked)
                      setDrawPref(e.target.checked)
                      if (!e.target.checked) drawAbort.current?.abort()
                    }}
                  />
                  <span>
                    Draw a picture from my story as I write
                    <small>Off unless you turn it on. Your story goes to Google Gemini and Pollinations to draw it; the picture is kept only on this device.</small>
                  </span>
                </label>
              </div>
            )}
          </section>
        )}

        {step === 1 && (
          <section className="step">
            <h1 className="step-title">
              What did you keep? <InfoTip>Photographs become the negative you’ll develop. No photograph? The darkroom will make a photogram from your words instead.</InfoTip>
            </h1>
            <div className="uploads">
              {photos.map((p, i) => (
                <figure key={p.id ?? p.url} className="upload">
                  {p.id && !p.url && <ExistingPhoto id={p.id} onUrl={(u) => setPhotos((ps) => ps.map((x) => (x.id === p.id ? { ...x, url: u } : x)))} />}
                  {p.url && <img src={p.url} alt={`Photograph ${i + 1}`} />}
                  <figcaption>
                    {i === 0 ? 'the negative' : `frame ${i + 1}`}
                    {p.drawn && <span className="app-mark" title="Drawn from your words"> ◇ drawn</span>}
                    <span>
                      {i > 0 && (
                        <button type="button" className="link" onClick={() => setPhotos((ps) => [ps[i], ...ps.filter((_, k) => k !== i)])}>
                          make first
                        </button>
                      )}
                      <button type="button" className="link danger" onClick={() => setPhotos((ps) => ps.filter((_, k) => k !== i))}>
                        remove
                      </button>
                    </span>
                  </figcaption>
                </figure>
              ))}
              <PhotoDrop onFiles={(fs) => setPhotos((ps) => [...ps, ...fs.map((file) => ({ file, url: URL.createObjectURL(file) }))])} />
            </div>

            <h2 className="step-sub">
              The song <InfoTip>It sets the page’s rhythm and colour: the tempo decides how long each photograph stays, the key warms or mutes the palette, the genre and year can turn the page into a collage or an old film print.</InfoTip>
            </h2>
            <div className="fields-2">
              <label className="field">
                <span>Title</span>
                <input value={song.title} onChange={(e) => setSong({ ...song, title: e.target.value })} placeholder="The song that was playing" />
              </label>
              <label className="field">
                <span>Artist</span>
                <input value={song.artist} onChange={(e) => setSong({ ...song, artist: e.target.value })} />
              </label>
            </div>
            <label className="field">
              <span>Link (Spotify, Apple Music, YouTube, Bandcamp…)</span>
              <input type="url" value={song.url} onChange={(e) => setSong({ ...song, url: e.target.value })} placeholder="https://" />
            </label>
            <div className="field">
              <span>How it felt</span>
              <div className="chips">
                {TEMPOS.map(([k, label]) => (
                  <button key={k} type="button" className={`chip ${tempo === k ? 'is-on' : ''}`} aria-pressed={tempo === k} onClick={() => setTempo(k)}>
                    {label}
                  </button>
                ))}
              </div>
            </div>
            <div className="field">
              <span>The key</span>
              <div className="chips">
                {(
                  [
                    ['major', 'Major, bright'],
                    ['minor', 'Minor, darker'],
