   The slab's components read the same --dr-* names, so only the palette changes. */
.dark-slab {
  --dr-bg: #ebe0cb;
  --dr-bg-2: #e1d3ba;
  --dr-ink: #2b231c;
  --dr-muted: #65584a;
  --dr-rule: rgb(43 35 28 / 0.18);
  --dr-accent: #8e4429;
  background: var(--dr-bg) url('/demo/textures/paper-ivory.jpg') center / 560px auto;
  background-blend-mode: multiply;
  border-radius: 6px;
  box-shadow:
    inset 0 0 0 1px rgb(43 35 28 / 0.1),
    inset 0 0 48px rgb(130 96 52 / 0.16);
}
/* the night print is dark paper already: its letters stay on the dark */
.print.theme-night .dark-slab {
  --dr-bg: #1d1814;
  --dr-bg-2: #29221c;
  --dr-ink: #efe4d3;
  --dr-muted: #a89684;
  --dr-rule: rgba(239, 228, 211, 0.16);
  --dr-accent: #d3875f;
  background: var(--dr-bg);
  box-shadow: none;
}

/* ---- the landing: from the film's dark to the paper, slowly ----
   The film ends in its dark; the manifesto stands on that same dark; then, over about one screen of
   scrolling, the dark warms through sepia into the paper, the way a print comes up in the tray.
   No colour changes in a single step, and there is never an empty screen of one colour. */
.landing .l-ink-zone {
  background: linear-gradient(
    to bottom,
    #17110d 0,
    #17110d 58svh,
    #1d150f 66svh,
    #2c2018 76svh,
    #47362a 88svh,
    #6f5c4b 101svh,
    #a08e7a 114svh,
    #cbbda9 126svh,
    #e6dccc 138svh,
    var(--ivory) 150svh
  );
}
.landing .l-ink-zone > .l-manifesto {
  min-height: 150svh;
  /* the words arrive as soon as the film has gone dark: no empty screen in between */
  padding-top: clamp(36px, 7svh, 80px);
  color: #f3ede2;
}
.landing .l-ink-zone > .l-manifesto em {
  color: #e8c48a;
}

/* Reduced motion: the film is one still frame. Its top and bottom fade into the dark around it, so the hero
   above and the words below meet it without a hard line; the caption stays above the fade. */
@media (prefers-reduced-motion: reduce) {
  .landing .l-film-dusk {
    opacity: 1;
    background: linear-gradient(180deg, #17110d 0%, rgba(23, 17, 13, 0) 26%, rgba(23, 17, 13, 0) 56%, #17110d 100%);
  }
  .landing .l-film-line {
    z-index: 2;
  }
}

/* The closing light stays a soft warm glow under paper rather than a wall of flame: the videos are
   desaturated and the paper veil holds more of the frame. */
.landing .l-morph-bg > video {
  filter: blur(calc((1 - var(--enter)) * 9px)) saturate(calc(0.45 + var(--enter) * 0.27));
}
.landing .l-final-veil {
  background: radial-gradient(
    ellipse 64% 60% at 50% 46%,
    rgba(243, 237, 226, 0.93) 0%,
    rgba(243, 237, 226, 0.8) 45%,
    rgba(243, 237, 226, 0.52) 80%,
    rgba(243, 237, 226, 0.4) 100%
  );
}

/* ---- a letter arrives: on a writing desk in daylight, not in the dark ----
   The room keeps the darkroom's components, so only its palette changes: warm sand paper for the desk,
   cream sheets with a soft shadow for the letters, ink-dark words. */
.darkroom.arrival {
  --dr-bg: #e4d8c3;
  --dr-bg-2: #dccdb4;
  --dr-ink: #2b231c;
  --dr-muted: #5e5143;
  --dr-rule: rgb(43 35 28 / 0.16);
  --dr-accent: #8e4429;
  --dr-glow: rgb(255 249 236 / 0.85);
  --dr-head: var(--serif);
  background:
    radial-gradient(ellipse 75% 55% at 50% -12%, var(--dr-glow), transparent 72%),
    radial-gradient(ellipse 120% 70% at 50% 118%, rgb(110 78 44 / 0.2), transparent 62%),
    var(--dr-bg) url('/demo/textures/paper-ivory.jpg') center / 640px auto;
  background-blend-mode: normal, normal, multiply;
  color: var(--dr-ink);
}
.darkroom.arrival::after {
  display: none;
}
.arrival .dr-name {
  color: var(--dr-ink);
}
.arrival .letter {
  /* a clean cream sheet: the linen only shows through faintly, so the letter is the lightest thing in the room */
  background-image: linear-gradient(rgb(255 252 245 / 0.8), rgb(255 252 245 / 0.8)), url('/demo/textures/linen.jpg');
  background-size: auto, 460px;
  box-shadow:
    0 1px 2px rgb(60 40 20 / 0.1),
    0 22px 44px -22px rgb(70 46 22 / 0.42);
}
.arrival .letter-past {
  /* the older letter: the same paper, a little more aged */
  background-image: linear-gradient(rgb(250 243 230 / 0.62), rgb(250 243 230 / 0.62)), url('/demo/textures/linen.jpg');
  background-size: auto, 460px;
  opacity: 1;
  box-shadow:
    0 1px 1px rgb(60 40 20 / 0.08),
    0 10px 22px -16px rgb(70 46 22 / 0.35);
}
.arrival .letter-head {
  color: #6b6258;
}
.arrival .sealed {
  background: rgb(251 246 236 / 0.55);
  border-color: rgb(43 35 28 / 0.22);
}
.arrival-body > .btn {
  justify-self: start;
}

