/* ===================== app upgrade: search palette, shortcuts, toasts, stats, filters, backup ===================== */
html.no-scroll {
  overflow: hidden;
}

/* soft cross-fade between rooms */
::view-transition-old(root) {
  animation: vt-out 0.22s var(--ease) both;
}
::view-transition-new(root) {
  animation: vt-in 0.34s var(--ease) both;
}
@keyframes vt-out {
  to {
    opacity: 0;
    transform: translateY(-6px);
    filter: blur(2px);
  }
}
@keyframes vt-in {
  from {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(3px);
  }
}

kbd {
