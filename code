/* ==========================================================================
   THE STRANGER — a contact sheet of six negatives under the safelight.
   Built on the darkroom tokens (--dr-*) so it reads as the same building.
   ========================================================================== */

.stranger {
  --dr-bg: #15100c;
  --dr-bg-2: #1e1611;
  --dr-ink: #efe4d3;
  --dr-muted: #a89684;
  --dr-rule: rgba(239, 228, 211, 0.14);
  --dr-accent: #d3875f;
  --st-safe: #8e2a24;
  --st-film: #0c0907;
  min-height: calc(100vh - 60px);
  padding: 0 var(--gutter) 96px;
  color: var(--dr-ink);
  background:
    radial-gradient(ellipse 60% 40% at 50% -8%, rgba(160, 52, 34, 0.32), transparent 70%),
    var(--dr-bg);
  transition: background 1.2s var(--ease);
}
.stranger.is-found {
  background:
    radial-gradient(ellipse 75% 55% at 50% -8%, rgba(176, 40, 32, 0.55), transparent 72%),
    var(--dr-bg);
}
.stranger .link {
  color: var(--dr-muted);
}
.stranger .link:hover {
  color: var(--dr-ink);
}
.stranger .app-mark {
  color: var(--dr-accent);
}

.st-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  max-width: 1120px;
  margin: 0 auto;
  padding: 20px 0 0;
}
.st-bar-k {
  font: 600 11px var(--sans);
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--dr-accent);
}
.st-bar-link {
  font: 500 13px var(--sans);
  color: var(--dr-muted);
  text-decoration: none;
}
.st-bar-link:hover {
  color: var(--dr-ink);
}

.st-kicker {
  font: 600 11px/1.3 var(--sans);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dr-muted);
}
.st-fine {
  font: 400 13px/1.55 var(--sans);
  color: var(--dr-muted);
  max-width: 56ch;
}
.st-p {
  font: 400 15px/1.6 var(--sans);
  color: var(--dr-ink);
  max-width: 62ch;
}
.st-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 14px;
  align-items: center;
}
.st-acts-center {
  justify-content: center;
}

/* ---------- entry ---------- */
.st-entry {
  max-width: 720px;
  margin: 0 auto;
  padding: clamp(48px, 9vh, 96px) 0 20px;
  display: grid;
  gap: 18px;
  justify-items: center;
  text-align: center;
}
.st-sheet-deco {
  display: grid;
  grid-template-columns: repeat(6, 34px);
  gap: 6px;
  margin-bottom: 14px;
}
.st-sheet-deco i {
  height: 46px;
  border: 1px solid var(--dr-rule);
  background: linear-gradient(180deg, rgba(239, 228, 211, 0.06), rgba(239, 228, 211, 0.015));
  animation: st-enter 0.7s var(--ease) both;
}
.st-sheet-deco i:nth-child(4) {
  border-color: color-mix(in srgb, var(--st-safe) 70%, transparent);
  background: linear-gradient(180deg, rgba(142, 42, 36, 0.28), rgba(142, 42, 36, 0.05));
}
.st-title {
  font: 500 clamp(38px, 6vw, 64px) / 1.02 var(--serif);
  letter-spacing: -0.01em;
}
.st-sub {
  font: italic 400 clamp(20px, 2.4vw, 25px) / 1.35 var(--serif);
  color: color-mix(in srgb, var(--dr-ink) 82%, transparent);
  max-width: 34ch;
}
.st-play {
  margin-top: 10px;
  min-height: 56px;
  padding: 0 34px;
  border: 1px solid var(--dr-ink);
  border-radius: 2px;
  background: var(--dr-ink);
  color: var(--dr-bg);
  font: 600 13px var(--sans);
  letter-spacing: 0.24em;
  text-transform: uppercase;
  transition: background 0.3s, color 0.3s, transform 0.15s, box-shadow 0.4s;
}
.st-play:hover {
  background: #f6d7c4;
  box-shadow: 0 0 0 6px rgba(142, 42, 36, 0.25);
}
.st-play:active {
  transform: translateY(1px);
}
.st-play-sm {
  min-height: 48px;
  margin-top: 0;
  padding: 0 26px;
}
.st-stats {
  display: grid;
  grid-template-columns: repeat(3, auto);
  gap: 0;
  margin: 22px 0 0;
  border-top: 1px solid var(--dr-rule);
  border-bottom: 1px solid var(--dr-rule);
}
.st-stats div {
  padding: 12px 20px;
}
.st-stats div + div {
  border-left: 1px solid var(--dr-rule);
}
.st-stats dt {
  font: 600 10px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--dr-muted);
}
.st-stats dd {
  margin: 4px 0 0;
  font: 500 26px/1 var(--serif);
}

/* ---------- setup ---------- */
.st-setup {
  width: 100%;
  display: grid;
  gap: 16px;
  margin-top: 18px;
  text-align: left;
}
.st-steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--dr-rule);
}
.st-steps li {
  padding: 12px 14px;
  font: 500 13px/1.3 var(--sans);
  color: var(--dr-muted);
  display: flex;
  gap: 8px;
  align-items: baseline;
}
.st-steps li + li {
  border-left: 1px solid var(--dr-rule);
}
.st-steps li.is-next {
  color: var(--dr-ink);
  background: rgba(142, 42, 36, 0.18);
}
.st-steps li.is-done {
  color: color-mix(in srgb, var(--dr-ink) 70%, transparent);
}
.st-step-n {
  font: 600 11px var(--mono);
  color: var(--dr-accent);
}
.st-panel {
  border: 1px solid var(--dr-rule);
  padding: 20px;
  display: grid;
  gap: 14px;
}
.st-panel-paper {
  background: var(--paper);
  color: var(--ink);
  border-color: transparent;
}
.st-panel-paper .link {
  color: var(--ink-2);
}
.st-panel-paper .link:hover {
  color: var(--ink);
}

/* ---------- developing (loading) ---------- */
.st-developing {
  display: grid;
  justify-items: center;
  gap: 26px;
  padding: clamp(80px, 16vh, 160px) 0;
}
.st-tray {
  display: grid;
  grid-template-columns: repeat(3, 58px);
  gap: 8px;
}
.st-tray i {
  height: 72px;
  border: 1px solid var(--dr-rule);
  background: var(--st-film);
  animation: st-tray 1.6s ease-in-out infinite;
}
.st-dev-line {
  font: italic 400 22px var(--serif);
  color: var(--dr-ink);
  min-height: 1.4em;
  animation: st-fade 0.5s var(--ease) both;
}

/* ---------- the board ---------- */
.st-round {
  max-width: 1120px;
  margin: 0 auto;
  padding-top: 30px;
}
.st-status {
  display: flex;
  align-items: center;
  gap: 14px;
  font: 500 14px var(--sans);
  color: var(--dr-muted);
  min-height: 28px;
}
.st-tries {
  display: inline-flex;
  gap: 6px;
}
.st-tries i {
  width: 12px;
  height: 18px;
  border: 1px solid var(--dr-muted);
  transition: background 0.4s;
}
.st-tries i.is-left {
  background: var(--dr-ink);
  border-color: var(--dr-ink);
}
.st-demo-note {
  margin-top: 8px;
  font: 500 12px var(--sans);
  letter-spacing: 0.06em;
  color: var(--dr-accent);
}

.st-sheet {
  list-style: none;
  margin: 18px 0 0;
  padding: 18px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  background: var(--st-film);
  /* sprocket holes along the long edges */
  background-image:
    radial-gradient(circle at 50% 50%, #2a211b 0 3px, transparent 3.5px),
    radial-gradient(circle at 50% 50%, #2a211b 0 3px, transparent 3.5px);
  background-size: 22px 10px, 22px 10px;
  background-repeat: repeat-x;
  background-position: 0 3px, 0 calc(100% - 3px);
  animation: st-perf 24s linear infinite;
}

.st-frame {
  position: relative;
  min-width: 0;
  animation: st-enter 0.6s var(--ease) both;
}
.st-frame-in {
  position: relative;
  height: 100%;
  min-height: 220px;
  display: grid;
  grid-template-rows: auto 1fr auto auto;
  gap: 12px;
  padding: 10px 16px;
  border: 1px solid rgba(239, 228, 211, 0.12);
  background: linear-gradient(180deg, #1b1410, #120d0a);
  color: var(--dr-ink);
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
  touch-action: manipulation;
  outline-offset: 2px;
  transition: background 0.9s var(--ease), color 0.9s var(--ease), border-color 0.6s, transform 0.25s var(--ease), box-shadow 0.4s;
}
.st-frame.is-neg .st-frame-in[role='button'] {
  cursor: pointer;
}
.st-frame.is-neg .st-frame-in[role='button']:hover {
  border-color: rgba(239, 228, 211, 0.34);
  box-shadow: 0 0 0 1px rgba(239, 228, 211, 0.08), 0 20px 40px -30px rgba(0, 0, 0, 0.9);
}
.st-frame.is-holding .st-frame-in {
  transform: scale(0.985);
  border-color: color-mix(in srgb, var(--st-safe) 80%, white 10%);
}
.st-edge {
  display: flex;
  justify-content: space-between;
  font: 600 9px var(--mono);
  letter-spacing: 0.16em;
  color: rgba(211, 135, 95, 0.55);
}
.st-text {
  align-self: center;
  font: italic 400 clamp(19px, 1.7vw, 22px) / 1.38 var(--serif);
  overflow-wrap: anywhere;
}
.st-hold {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3px;
  background: var(--st-safe);
  transform: scaleX(0);
  transform-origin: left;
}
.st-frame.is-holding .st-hold {
  animation: st-hold 0.8s linear forwards;
}

/* a real memory develops onto warm paper */
.st-frame.is-real .st-frame-in {
  background: var(--paper);
  color: var(--ink);
  border-color: var(--paper);
  animation: st-develop 1.1s var(--ease) both;
}
.st-frame.is-real .st-edge {
  color: var(--ink-3);
}
.st-frame.is-real.is-wrong .st-frame-in {
  box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--burgundy) 55%, transparent);
}

/* the Stranger stays a negative, lit red */
.st-frame.is-stranger .st-frame-in {
  background: radial-gradient(ellipse 120% 90% at 50% 0%, rgba(176, 40, 32, 0.5), rgba(60, 12, 10, 0.92) 70%), #170605;
  border-color: #b1352c;
  color: #f3d9cf;
  animation: st-safelight 1.2s var(--ease) both;
}
.st-frame.is-stranger .st-edge {
  color: #e48a7c;
}

.st-reveal {
  display: grid;
  gap: 6px;
  animation: st-fade 0.9s 0.25s var(--ease) both;
}
.st-reveal-real {
  border-top: 1px solid var(--rule);
  padding-top: 10px;
}
.st-wrote {
  font: 600 11px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--burgundy);
}
.st-date {
  font: 500 20px var(--serif);
}
.st-where {
  font: 400 13px/1.45 var(--sans);
  color: var(--ink-2);
}
.st-demo-tag {
  color: var(--terra);
}
.st-thumb {
  width: 120px;
  margin: 4px 0;
}
.st-thumb .photo,
.st-thumb img {
  aspect-ratio: 3 / 2;
  object-fit: cover;
  width: 100%;
}
.st-open {
  font: 500 13px var(--sans);
  color: var(--ink);
  text-underline-offset: 4px;
}
.st-reveal-ai {
  border-top: 1px solid rgba(243, 217, 207, 0.25);
  padding-top: 12px;
}
.st-stamp {
  justify-self: start;
  padding: 4px 10px;
  border: 1.5px solid #f3d9cf;
  font: 700 12px var(--mono);
  letter-spacing: 0.26em;
  text-transform: uppercase;
  transform: rotate(-2.5deg);
  animation: st-stamp 0.45s 0.35s var(--ease) both;
}
.st-reveal-ai p {
  font: 500 15px var(--sans);
}
.st-reveal-ai .st-reveal-fine {
  font: 400 13px/1.45 var(--sans);
  color: #d8aea2;
}

.st-sheet.is-done .st-frame.is-neg .st-frame-in[role='button']:hover {
  border-color: rgba(239, 228, 211, 0.4);
}

/* ---------- results ---------- */
.st-results {
  margin-top: 28px;
  padding: 26px 0 0;
  border-top: 1px solid var(--dr-rule);
  display: grid;
  gap: 18px;
  animation: st-fade 0.8s 0.4s var(--ease) both;
}
.st-res-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
}
.st-res-h {
  font: 600 11px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--dr-muted);
  margin-bottom: 10px;
}
.st-res-ai {
  margin: 0;
  padding-left: 14px;
  border-left: 2px solid #b1352c;
  font: italic 400 22px/1.35 var(--serif);
}
.st-res-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}
.st-res-list li {
  display: grid;
  gap: 2px;
  font: italic 400 18px/1.35 var(--serif);
}
.st-res-list small {
  font: 400 12px var(--sans);
  color: var(--dr-muted);
}
.st-res-score {
  font: 500 14px var(--sans);
  color: var(--dr-muted);
}
.st-glyphs {
  font: 600 18px var(--mono);
  letter-spacing: 0.18em;
  color: var(--dr-ink);
  margin-right: 10px;
}

/* ---------- AI configuration (Settings + onboarding) ---------- */
.sai {
  display: grid;
  gap: 14px;
}
.sai-block {
  display: grid;
  gap: 10px;
}
.sai-block + .sai-block {
  border-top: 1px solid var(--rule);
  padding-top: 16px;
}
.sai-h {
  font: 600 11px var(--sans);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--burgundy);
}
.sai-p {
  font: 400 14px/1.55 var(--sans);
  color: var(--ink-2);
  max-width: 70ch;
}
.sai-fine {
  font: 400 12.5px/1.55 var(--sans);
  color: var(--ink-3);
  max-width: 72ch;
}
.sai-fine.is-warn {
  color: var(--burgundy);
}
.sai-keys {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 6px;
}
.sai-keys li {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  align-items: center;
  padding: 8px 10px;
  border: 1px solid var(--rule);
}
.sai-keys li.is-next {
  border-color: var(--ink-3);
}
.sai-key-n {
  font: 600 11px var(--mono);
  color: var(--ink-3);
}
.sai-key {
  font: 500 13px var(--mono);
  overflow-wrap: anywhere;
}
.sai-key-acts {
  display: inline-flex;
  gap: 12px;
  margin-left: auto;
}
.sai-key-acts .link {
  font-size: 13px;
}
.sai-test {
  flex-basis: 100%;
  font: 400 12.5px var(--sans);
  color: var(--burgundy);
}
.sai-test.is-ok {
  color: var(--olive);
}
.sai-edit {
  display: flex;
  flex: 1;
  gap: 8px;
  align-items: center;
}
.sai-edit input,
.sai-input {
  flex: 1;
  min-width: 0;
  padding: 9px 11px;
  border: 1px solid var(--rule);
  background: var(--ivory);
  font: 400 13px var(--mono);
  color: var(--ink);
  border-radius: 2px;
}
.sai-add {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}
.sai-input {
  resize: vertical;
}
.sai-list {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 6px;
  font: 400 13.5px/1.55 var(--sans);
  color: var(--ink-2);
}
.sai-consent {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font: 500 14px/1.5 var(--sans);
  cursor: pointer;
}
.sai-consent input {
  margin-top: 4px;
  accent-color: var(--burgundy);
}
.sai-consent.is-on {
  cursor: default;
  flex-wrap: wrap;
  color: var(--olive);
}
.sai-summary {
  margin: 0;
  padding-left: 12px;
  border-left: 2px solid var(--rule);
  font: italic 400 16px/1.45 var(--serif);
  color: var(--ink);
}
.sai-progress {
  font: italic 400 15px var(--serif);
  color: var(--burgundy);
}
.sai-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 12px;
  align-items: center;
}
.sai-acts .link {
  font-size: 13px;
}
.sai-log {
  list-style: none;
  margin: 0;
  padding: 0;
  font: 400 12px var(--mono);
  color: var(--ink-3);
  display: grid;
  gap: 2px;
}
.sai-log li {
  display: grid;
  grid-template-columns: 52px 1fr 56px auto;
  gap: 10px;
}
.sai-log .is-ok {
  color: var(--olive);
}
.sai-log .is-bad {
  color: var(--burgundy);
}
.sai-error {
  padding: 10px 12px;
  border-left: 3px solid var(--burgundy);
  background: color-mix(in srgb, var(--burgundy) 9%, transparent);
  font: 500 13.5px/1.5 var(--sans);
  color: var(--burgundy);
}
.stranger .st-setup > .sai-error {
  color: #f3c9bd;
  background: rgba(142, 42, 36, 0.25);
  border-left-color: #b1352c;
}
.set-stranger {
  padding: 18px 20px;
  border-radius: 18px;
}

/* ---------- motion ---------- */
@keyframes st-enter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
}
@keyframes st-fade {
  from {
    opacity: 0;
  }
}
@keyframes st-hold {
  to {
    transform: scaleX(1);
  }
}
@keyframes st-develop {
  0% {
    background: #120d0a;
    color: transparent;
    filter: blur(2px);
  }
  45% {
    background: #c9b59a;
    color: rgba(38, 34, 30, 0.2);
  }
  100% {
    filter: none;
  }
}
@keyframes st-safelight {
  0% {
    background: #120d0a;
    box-shadow: 0 0 0 0 rgba(176, 40, 32, 0);
  }
  40% {
    box-shadow: 0 0 60px 10px rgba(176, 40, 32, 0.45);
  }
  100% {
    box-shadow: 0 0 30px -6px rgba(176, 40, 32, 0.35);
  }
}
@keyframes st-stamp {
  from {
    opacity: 0;
    transform: rotate(-2.5deg) scale(1.6);
  }
}
@keyframes st-tray {
  50% {
    background: #3a2a20;
  }
}
@keyframes st-perf {
  to {
    background-position: 440px 3px, -440px calc(100% - 3px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .stranger *,
  .stranger *::before,
  .stranger *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  /* the hold bar is information, not decoration: it still fills */
  .st-frame.is-holding .st-hold {
    animation-duration: 0.8s !important;
  }
}

/* ---------- small screens ---------- */
@media (max-width: 900px) {
  .st-sheet {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .st-res-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 600px) {
  .stranger {
    padding: 0 16px 110px;
  }
  .st-sheet {
    grid-template-columns: 1fr;
    padding: 16px 10px;
    gap: 10px;
  }
  .st-frame-in {
    min-height: 0;
  }
  .st-text {
    font-size: 19px;
  }
  .st-stats {
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
  }
  .st-stats div:nth-child(3) {
    border-left: 0;
  }
  .st-stats div:nth-child(n + 3) {
    border-top: 1px solid var(--dr-rule);
  }
  .st-steps {
    grid-template-columns: 1fr 1fr;
  }
  .st-steps li:nth-child(3) {
    border-left: 0;
  }
  .st-steps li:nth-child(n + 3) {
    border-top: 1px solid var(--dr-rule);
  }
  .st-status {
    flex-wrap: wrap;
    font-size: 13px;
  }
  .sai-add {
    flex-direction: column;
    align-items: stretch;
  }
  .sai-key-acts {
    margin-left: 0;
  }
  .st-acts .st-play {
    width: 100%;
  }
}

