  color: var(--ink-2);
  margin: 0 0 28px;
}
.legal-body h2 {
  font: 600 13px/1.3 var(--sans);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 32px 0 10px;
}
.legal-body p,
.legal-body li {
  line-height: 1.65;
  max-width: 64ch;
}
.legal-body ul {
  padding-left: 1.1em;
  display: grid;
  gap: 10px;
}
.legal-foot {
  margin-top: 44px;
